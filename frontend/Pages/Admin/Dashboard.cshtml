@page "/admin-panel"
@model BoostingHub.frontend.Pages.Admin.DashboardModel
@using System.Text.Json
@{
    ViewData["Title"] = "Admin Panel";
    ViewData["BodyClass"] = "admin-page";
}

    <div class="admin-header">
        <h3><i class="bi bi-shield-lock-fill text-primary"></i> Admin Panel</h3>
        <div class="admin-header-right">
            <button id="themeToggle" class="btn btn-sm btn-outline-primary me-3 border-0" aria-label="Toggle Theme">
                <i class="bi bi-moon-stars fs-5"></i>
            </button>
            <div class="user-profile-dropdown" id="profileDropdown">
                <span class="admin-user-badge" onclick="toggleProfileMenu()">
                    <i class="bi bi-person-circle"></i> Admin
                    <i class="bi bi-chevron-down profile-dropdown-caret"></i>
                </span>
                <div class="profile-menu hidden" id="profileMenu">
                    <a href="/logout" class="profile-menu-item"><i class="bi bi-box-arrow-right"></i> Logout</a>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-content">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger mb-4 alert-break">@Model.ErrorMessage</div>
        }

        <!-- â”€â”€ Stat Cards Row â”€â”€ -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="stat-card stat-card-grad stat-card-grad-indigo">
                    <div class="stat-icon"><i class="bi bi-people"></i></div>
                    <div class="stat-info">
                        <span class="stat-label">Total Users</span>
                        <span class="stat-value">@Model.Dashboard.TotalUsers</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-card-grad stat-card-grad-teal">
                    <div class="stat-icon"><i class="bi bi-cart-check"></i></div>
                    <div class="stat-info">
                        <span class="stat-label">Total Orders</span>
                        <span class="stat-value">@Model.Dashboard.TotalOrders</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-card-grad stat-card-grad-green">
                    <div class="stat-icon"><i class="bi bi-currency-dollar"></i></div>
                    <div class="stat-info">
                        <span class="stat-label">Revenue</span>
                        <span class="stat-value">₨ @Model.Dashboard.TotalRevenue.ToString("N2")</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-card-grad stat-card-grad-blue">
                    <div class="stat-icon"><i class="bi bi-check2-all"></i></div>
                    <div class="stat-info">
                        <span class="stat-label">Completed Tasks</span>
                        <span class="stat-value">@Model.Dashboard.CompletedTasks</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-card-grad stat-card-grad-amber">
                    <div class="stat-icon"><i class="bi bi-arrow-up-circle"></i></div>
                    <div class="stat-info">
                        <span class="stat-label">In Progress</span>
                        <span class="stat-value">@Model.Dashboard.InProgressTasks</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-7">
                <div class="card shadow-sm border-0 chart-card chart-line">
                    <div class="card-body">
                        <h5 class="card-title fw-semibold mb-3"><i class="bi bi-graph-up text-primary"></i> Daily Orders (7 days)</h5>
                        <canvas id="lineChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card shadow-sm border-0 chart-card chart-pie">
                    <div class="card-body">
                        <h5 class="card-title fw-semibold mb-3"><i class="bi bi-pie-chart text-primary"></i> Orders by Status</h5>
                        <canvas id="pieChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

    </div><!-- /admin-content -->

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                if (typeof showToast === 'function') showToast('@TempData["Success"]', 'success');
            });
        </script>
    }
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        var lineLabels = @Html.Raw(JsonSerializer.Serialize(Model.Dashboard.LineChart.Labels));
        var lineData   = @Html.Raw(JsonSerializer.Serialize(Model.Dashboard.LineChart.Data));
        var pieLabels  = @Html.Raw(JsonSerializer.Serialize(Model.Dashboard.PieChart.Labels));
        var pieData    = @Html.Raw(JsonSerializer.Serialize(Model.Dashboard.PieChart.Data));
        var pieColors  = @Html.Raw(JsonSerializer.Serialize(Model.Dashboard.PieChart.BackgroundColors));

        function isLight() { return document.body.classList.contains('light-mode'); }

        var lineChart = new Chart(document.getElementById('lineChart'), {
            type: 'line',
            data: {
                labels: lineLabels,
                datasets: [{
                    label: 'Orders',
                    data: lineData,
                    borderColor: '#6366F1',
                    backgroundColor: 'rgba(99,102,241,0.12)',
                    fill: true, tension: 0.4
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { ticks: { color: isLight() ? '#64748B' : 'rgba(241,245,249,0.4)' }, grid: { color: isLight() ? 'rgba(0,0,0,0.06)' : 'rgba(255,255,255,0.05)' } },
                    y: { beginAtZero: true, ticks: { stepSize: 1, color: isLight() ? '#64748B' : 'rgba(241,245,249,0.4)' }, grid: { color: isLight() ? 'rgba(0,0,0,0.06)' : 'rgba(255,255,255,0.05)' } }
                }
            }
        });

        var pieChart = new Chart(document.getElementById('pieChart'), {
            type: 'doughnut',
            data: { labels: pieLabels, datasets: [{ data: pieData, backgroundColor: pieColors }] },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom', labels: { color: isLight() ? '#334155' : 'rgba(241,245,249,0.65)' } } }
            }
        });

        function updateChartTheme() {
            var light = isLight();
            lineChart.options.scales.x.ticks.color = light ? '#64748B' : 'rgba(241,245,249,0.4)';
            lineChart.options.scales.x.grid.color = light ? 'rgba(0,0,0,0.06)' : 'rgba(255,255,255,0.05)';
            lineChart.options.scales.y.ticks.color = light ? '#64748B' : 'rgba(241,245,249,0.4)';
            lineChart.options.scales.y.grid.color = light ? 'rgba(0,0,0,0.06)' : 'rgba(255,255,255,0.05)';
            lineChart.update();
            pieChart.options.plugins.legend.labels.color = light ? '#334155' : 'rgba(241,245,249,0.65)';
            pieChart.update();
        }

        function toggleProfileMenu() {
            var menu = document.getElementById('profileMenu');
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }
        document.addEventListener('click', function(e) {
            var pd = document.getElementById('profileDropdown');
            if (pd && !pd.contains(e.target)) {
                var m = document.getElementById('profileMenu');
                if (m) m.style.display = 'none';
            }
        });

        var themeObserver = new MutationObserver(function() { updateChartTheme(); });
        themeObserver.observe(document.body, { attributes: true, attributeFilter: ['class'] });
    </script>
}
