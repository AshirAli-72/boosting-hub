@page "/admin/orders"
@model BoostingHub.frontend.Pages.Admin.Inquiries.IndexModel
@using BoostingHub.backend.Common
@{
    ViewData["Title"] = "Orders";
    ViewData["BodyClass"] = "admin-page";

    string CurrencySymbol(string? currency) => (currency?.ToUpper() ?? "USD") switch {
        "PKR" => "₨",
        "EUR" => "\u20AC",
        "GBP" => "\u00A3",
        "INR" => "\u20B9",
        "BDT" => "\u09F3",
        "SAR" => "\uFDFC",
        "AED" => "AED ",
        "TRY" => "\u20BA",
        "NGN" => "\u20A6",
        "JPY" => "\u00A5",
        "CNY" => "\u00A5",
        "KRW" => "\u20A9",
        "PHP" => "\u20B1",
        "IDR" => "Rp",
        "MYR" => "RM",
        "THB" => "\u0E3F",
        "EGP" => "E\u00A3",
        "ZAR" => "R",
        "MXN" => "Mex$",
        _ => "$"
    };
}

        <div class="admin-header">
            <h3><i class="bi bi-inbox text-primary"></i> Orders</h3>
            <div class="admin-header-right">
                <button id="themeToggle" class="btn btn-sm btn-outline-primary me-3 border-0" aria-label="Toggle Theme">
                    <i class="bi bi-moon-stars fs-5"></i>
                </button>
                <div class="user-profile-dropdown" id="profileDropdown">
                    <span class="admin-user-badge" onclick="toggleProfileMenu()">
                        <i class="bi bi-person-circle"></i> Admin
                        <i class="bi bi-chevron-down profile-dropdown-caret"></i>
                    </span>
                    <div class="profile-menu hidden" id="profileMenu">
                        <a href="/logout" class="profile-menu-item"><i class="bi bi-box-arrow-right"></i> Logout</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="admin-content">
            <div class="admin-card admin-card-orders mb-4 border-0 shadow-sm">
                <div class="admin-card-header admin-card-header-orders d-flex justify-content-between align-items-center">
                    <h5 class="m-0"><i class="bi bi-list-check text-primary me-2"></i> All Orders</h5>
                        <span class="badge orders-count-badge">@Model.Orders.Count Total</span>
                </div>
                <div class="admin-card-body p-0">
                    <div class="table-responsive">
                        <table class="table admin-table mb-0 align-middle" id="coTable">
                            <thead class="admin-thead">
                                <tr>
                                    <th>ID</th>
                                    <th>Name / Email</th>
                                    <th>Platform(s)</th>
                                    <th>Service(s)</th>
                                    <th>Quantity</th>
                                    <th>Amount</th>
                                    <th>URL</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Orders.Any())
                                {
                                    foreach (var item in Model.Orders)
                                    {
                                        <tr>
                                            <td class="fw-semibold">#@item.Id</td>
                                            <td>
                                                <div class="fw-semibold">@(item.FullName ?? "—")</div>
                                                <div class="admin-td-small opacity-75">@(item.Email ?? "—")</div>
                                            </td>
                                            <td>
                                                @foreach (var p in item.Platform.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                                {
                                                    <span class="admin-badge admin-badge-purple me-1">@p</span>
                                                }
                                            </td>
                                            <td>
                                                @foreach (var s in item.Service.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                                {
                                                    <span class="admin-badge admin-badge-teal me-1">@s</span>
                                                }
                                            </td>
                                            <td><span class="fw-semibold">@item.Quantity</span></td>
                                            <td><span class="fw-bold text-success">@CurrencySymbol(item.Currency)@item.Budget.ToString("N2")</span></td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.SocialMediaUrl))
                                                {
                                                    <a href="@item.SocialMediaUrl" target="_blank" class="text-truncate d-inline-block text-primary admin-table-link" title="@item.SocialMediaUrl">
                                                        <i class="bi bi-link-45deg"></i> Link
                                                    </a>
                                                }
                                                else { <span class="opacity-50">—</span> }
                                            </td>
                                            <td>
                                                    @if (item.Status == StatusHelper.OrderPending)
                                                {
                                                    <span class="inquiry-status-badge inquiry-status-pending">Pending</span>
                                                }
                                                else if (item.Status == StatusHelper.OrderApproved)
                                                {
                                                    <span class="inquiry-status-badge inquiry-status-approved">Approved</span>
                                                }
                                                else if (item.Status == StatusHelper.OrderRejected)
                                                {
                                                    <span class="inquiry-status-badge inquiry-status-rejected">Rejected</span>
                                                }
                                                else
                                                {
                                                    <span class="inquiry-status-badge inquiry-status-rejected">@StatusHelper.OrderStatusToString(item.Status)</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="admin-td-small">@item.CreatedAt.ToString("MMM dd, yyyy")</span>
                                            </td>
                                            <td class="text-end pe-4">
                                                <div class="d-flex gap-2 justify-content-end align-items-center flex-wrap">
                                                    @if (item.Status == StatusHelper.OrderPending)
                                                    {
                                                        <button class="btn btn-sm btn-approve" onclick="approveOrder(@item.Id)"
                                                                title="Approve Order">
                                                            <i class="bi bi-check-circle"></i> Approve
                                                        </button>
                                                        <button class="btn btn-sm btn-reject" onclick="openRejectModal(@item.Id)"
                                                                title="Reject Order">
                                                            <i class="bi bi-x-circle"></i> Reject
                                                        </button>
                                                    }
                                                    <button class="btn btn-sm btn-outline-primary btn-collapse-toggle" type="button"
                                                            data-bs-toggle="collapse" data-bs-target="#collapse-@item.Id">
                                                        <i class="bi bi-chevron-down"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr class="collapse admin-collapse-row" id="collapse-@item.Id">
                                            <td colspan="10" class="admin-collapse-cell">
                                                <div class="admin-collapse-body">
                                                    <div class="order-sum-3col-three">
                                                        <div class="order-sum-card order-sum-card-square">
                                                            <div class="order-sum-card-title"><i class="bi bi-paperclip"></i> Attachment</div>
                                                            <div class="order-sum-card-body">
                                                                @if (!string.IsNullOrEmpty(item.Attachment))
                                                                {
                                                                    var isImage = item.Attachment.EndsWith(".png") || item.Attachment.EndsWith(".jpg") || item.Attachment.EndsWith(".jpeg") || item.Attachment.EndsWith(".gif") || item.Attachment.EndsWith(".webp");
                                                                    if (isImage)
                                                                    {
                                                                        <a href="/@item.Attachment" target="_blank" class="order-sum-card-image-link">
                                                                            <img src="/@item.Attachment" alt="Attachment" class="order-sum-card-image" />
                                                                        </a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <a href="/@item.Attachment" target="_blank" class="order-sum-card-file"><i class="bi bi-file-earmark-arrow-down"></i> @System.IO.Path.GetFileName(item.Attachment)</a>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <div class="order-sum-card-empty">No attachment</div>
                                                                }
                                                            </div>
                                                        </div>

                                                        <div class="order-sum-card order-sum-card-square">
                                                            <div class="order-sum-card-title"><i class="bi bi-credit-card-2-front-fill"></i> Paid Voucher</div>
                                                            <div class="order-sum-card-body">
                                                                @if (Model.PaymentProofs.TryGetValue(item.Id, out var proof) && !string.IsNullOrEmpty(proof.PaidVoucher))
                                                                {
                                                                    var pVIsImage = proof.PaidVoucher.EndsWith(".png") || proof.PaidVoucher.EndsWith(".jpg") || proof.PaidVoucher.EndsWith(".jpeg") || proof.PaidVoucher.EndsWith(".gif") || proof.PaidVoucher.EndsWith(".webp");
                                                                    if (pVIsImage)
                                                                    {
                                                                        <a href="/@proof.PaidVoucher" target="_blank" class="order-sum-card-image-link">
                                                                            <img src="/@proof.PaidVoucher" alt="Voucher" class="order-sum-card-image" />
                                                                        </a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <a href="/@proof.PaidVoucher" target="_blank" class="order-sum-card-file"><i class="bi bi-file-earmark-arrow-down"></i> View Voucher</a>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <div class="order-sum-card-empty">No voucher</div>
                                                                }
                                                            </div>
                                                        </div>

                                                        <div class="order-sum-card order-sum-card-square">
                                                            <div class="order-sum-card-title"><i class="bi bi-info-circle-fill"></i> Summary</div>
                                                            <div class="order-sum-card-body column">
                                                            <div class="order-sum-field full">
                                                                <span class="field-label">Platform</span>
                                                                <span class="field-value small">@item.Platform</span>
                                                            </div>
                                                                <div class="order-sum-field full">
                                                                    <span class="field-label">Service</span>
                                                                    <span class="field-value">@item.Service</span>
                                                                </div>
                                                                <div class="order-sum-field full">
                                                                    <span class="field-label">Amount</span>
                                                                    <span class="field-value strong green">@CurrencySymbol(item.Currency)@item.Budget.ToString("N2")</span>
                                                                </div>
                                                                <div class="order-sum-field full">
                                                                    <span class="field-label">Qty</span>
                                                                    <span class="field-value">@item.Quantity</span>
                                                                </div>
                                                                @if (!string.IsNullOrEmpty(item.SocialMediaUrl))
                                                                {
                                                                    <div class="order-sum-field full">
                                                                        <span class="field-label">URL</span>
                                                                        <span class="field-value url">
                                                                            <a href="@item.SocialMediaUrl" target="_blank" class="url-link">@item.SocialMediaUrl</a>
                                                                        </span>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="10" class="text-center py-5 text-muted">
                                            <i class="bi bi-inbox fs-1 d-block mb-3 opacity-50"></i>
                                            <span class="orders-empty-text">No client orders found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reject Modal -->
        <div class="pkg-modal-overlay" id="rejectOverlay" onclick="closeRejectModal()"></div>
        <div class="pkg-modal" id="rejectModal">
            <div class="pkg-modal-header">
                <h5><i class="bi bi-x-circle"></i> Reject Order</h5>
                <button class="pkg-modal-close" onclick="closeRejectModal()">&times;</button>
            </div>
            <div class="pkg-modal-body reject-modal-body">
                <p class="reject-modal-text">Please provide a reason for rejecting this order. This will be visible to the customer.</p>
                <input type="hidden" id="reject-order-id" />
                <textarea id="reject-reason" rows="4" placeholder="Enter rejection reason..." class="reject-reason-textarea"></textarea>
                <div class="reject-modal-actions">
                    <button class="btn btn-sm btn-modal-cancel" onclick="closeRejectModal()">Cancel</button>
                    <button class="btn btn-sm btn-modal-reject" id="rejectConfirmBtn" onclick="confirmReject()">Reject Order</button>
                </div>
            </div>
        </div>

<style>
    .order-sum-3col { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
    .order-sum-3col-three { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
    .order-sum-card-square { width:100%; height:180px; display:flex; flex-direction:column; padding:0; overflow:hidden; }
    .order-sum-card-square .order-sum-card-title { padding:10px 12px; margin-bottom:0; border-bottom:1px solid var(--border-subtle,#e2e8f0); flex-shrink:0; }
    .order-sum-card-body { flex:1; display:flex; align-items:center; justify-content:center; overflow:hidden; min-height:0; }
    .order-sum-card-image-link { display:flex; width:100%; height:100%; align-items:center; justify-content:center; }
    .order-sum-card-image { width:100%; height:100%; object-fit:cover; display:block; }
    .order-sum-card-file { font-size:0.72rem; color:#6366f1; text-decoration:none; text-align:center; padding:8px; }
    .order-sum-card-file:hover { text-decoration:underline; }
    .order-sum-card-empty { font-size:0.75rem; color:#94a3b8; }
    .order-sum-card { background:var(--bg-elevated,#fff); border:1px solid var(--border-subtle,#e2e8f0); border-radius:10px; padding:14px 16px; }
    .order-sum-card-title { font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.7px; color:#94a3b8; margin-bottom:10px; display:flex; align-items:center; gap:5px; }
    .order-sum-card-title i { font-size:0.78rem; }
    .order-sum-fields { display:flex; flex-direction:column; gap:6px; }
    .order-sum-field { display:flex; justify-content:space-between; align-items:center; padding:4px 0; border-bottom:1px solid var(--border-subtle,#f1f5f9); }
    .order-sum-field:last-child { border-bottom:none; }
    .order-sum-field .field-label { font-size:0.78rem; color:#94a3b8; font-weight:500; }
    .order-sum-field .field-value { font-size:0.78rem; color:var(--text-primary,#1e293b); font-weight:600; text-align:right; }
    .order-sum-field .field-value.strong { font-size:0.85rem; }
    .order-sum-field .field-value.mono { font-family:Consolas,monospace; letter-spacing:0.2px; }
    .sum-tag { display:inline-block; font-size:0.65rem; font-weight:600; padding:2px 8px; border-radius:999px; margin:1px 2px; }
    .sum-tag.tag-purple { background:rgba(99,102,241,0.1); color:#6366f1; }
    .sum-tag.tag-teal { background:rgba(20,184,166,0.1); color:#14b8a6; }
    .order-sum-attachment { display:flex; align-items:center; gap:10px; }
    .sum-thumb { width:50px; height:50px; object-fit:cover; border-radius:8px; border:1px solid var(--border-subtle,#e2e8f0); flex-shrink:0; }
    .sum-thumb:hover { opacity:0.8; }
    .sum-thumb-info { display:flex; flex-direction:column; gap:2px; min-width:0; }
    .sum-thumb-name { font-size:0.75rem; font-weight:600; color:var(--text-primary,#1e293b); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .sum-thumb-view,
    .sum-thumb-file { font-size:0.68rem; color:#6366f1; text-decoration:none; display:inline-flex; align-items:center; gap:4px; }
    .sum-thumb-view:hover,
    .sum-thumb-file:hover { text-decoration:underline; color:#4f46e5; }
    .order-sum-payment { display:flex; flex-direction:column; gap:5px; }
    .pay-row { display:flex; justify-content:space-between; align-items:center; padding:3px 0; font-size:0.8rem; }
    .pay-row .field-label { color:#94a3b8; font-weight:500; }
    .pay-row .field-value { color:var(--text-primary,#1e293b); font-weight:600; }
    .pay-row .field-value.strong { font-size:0.95rem; color:#16a34a; }
</style>

@section Scripts {
    <script src="~/js/site.js"></script>
    <script src="~/js/table-pager.js"></script>
    <script>
        initTablePager('coTable');
        function toggleProfileMenu() {
            var menu = document.getElementById('profileMenu');
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }
        document.addEventListener('click', function(e) {
            var pd = document.getElementById('profileDropdown');
            if (pd && !pd.contains(e.target)) {
                var m = document.getElementById('profileMenu');
                if (m) m.style.display = 'none';
            }
        });

        async function approveOrder(id) {
            if (!confirm('Are you sure you want to approve this order? Tasks will be generated.')) return;
            try {
                var resp = await fetch('/api/orders/' + id + '/approve', { method: 'POST' });
                var data = await resp.json();
                if (resp.ok) {
                    showToast(data.message || 'Order approved!', 'success');
                    setTimeout(function() { location.reload(); }, 1000);
                } else {
                    showToast(data.message || 'Failed to approve order.', 'error');
                }
            } catch(err) {
                showToast('Network error.', 'error');
            }
        }

        function openRejectModal(id) {
            document.getElementById('reject-order-id').value = id;
            document.getElementById('reject-reason').value = '';
            document.getElementById('rejectOverlay').style.display = 'block';
            document.getElementById('rejectModal').style.display = 'block';
        }

        function closeRejectModal() {
            document.getElementById('rejectOverlay').style.display = 'none';
            document.getElementById('rejectModal').style.display = 'none';
        }

        async function confirmReject() {
            var id = document.getElementById('reject-order-id').value;
            var reason = document.getElementById('reject-reason').value.trim();
            if (!reason) { alert('Please enter a reason for rejection.'); return; }
            var btn = document.getElementById('rejectConfirmBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Rejecting...';
            try {
                var resp = await fetch('/api/orders/' + id + '/reject', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason: reason })
                });
                var data = await resp.json();
                if (resp.ok) {
                    closeRejectModal();
                    showToast(data.message || 'Order rejected.', 'success');
                    setTimeout(function() { location.reload(); }, 1000);
                } else {
                    showToast(data.message || 'Failed to reject.', 'error');
                }
            } catch(err) {
                showToast('Network error.', 'error');
            }
            btn.disabled = false;
            btn.innerHTML = 'Reject Order';
        }
    </script>
}
