@page "/admin/settings"
@model BoostingHub.frontend.Pages.Admin.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
    ViewData["BodyClass"] = "admin-page";
}

        <div class="admin-header">
            <h3><i class="bi bi-gear text-primary"></i> Settings</h3>
            <div class="admin-header-right">
                <button id="themeToggle" class="btn btn-sm btn-outline-primary me-3 border-0" aria-label="Toggle Theme">
                    <i class="bi bi-moon-stars fs-5"></i>
                </button>
                <div class="user-profile-dropdown" id="profileDropdown">
                    <span class="admin-user-badge" onclick="toggleProfileMenu()">
                        <i class="bi bi-person-circle"></i> Admin
                        <i class="bi bi-chevron-down profile-dropdown-caret"></i>
                    </span>
                    <div class="profile-menu hidden" id="profileMenu">
                        <a href="/logout" class="profile-menu-item"><i class="bi bi-box-arrow-right"></i> Logout</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="admin-content">
            <div class="row g-4">
                @* â”€â”€ Roles & Permissions (coming soon) â”€â”€ *@
                @*
                <div class="col-md-4">
                    <a href="/admin/roles" class="text-decoration-none">
                        <div class="card shadow-sm border-0 h-100 settings-card-clickable">
                            <div class="card-body text-center py-5">
                                <div class="settings-card-icon icon-color-purple"><i class="bi bi-shield-lock"></i></div>
                                <h5 class="fw-semibold">Roles & Permissions</h5>
                                <p class="text-muted mb-0">Create and manage roles, assign permissions to control access</p>
                            </div>
                        </div>
                    </a>
                </div>
                *@
                @* â”€â”€ User Management (coming soon) â”€â”€ *@
                @*
                <div class="col-md-4">
                    <a href="/admin/users" class="text-decoration-none">
                        <div class="card shadow-sm border-0 h-100 settings-card-clickable">
                            <div class="card-body text-center py-5">
                                <div class="settings-card-icon icon-color-teal"><i class="bi bi-people"></i></div>
                                <h5 class="fw-semibold">User Management</h5>
                                <p class="text-muted mb-0">Create users, assign roles, and manage user accounts</p>
                            </div>
                        </div>
                    </a>
                </div>
                *@
                <div class="col-md-4">
                    <a href="/admin/settings/accounts" class="text-decoration-none">
                        <div class="card shadow-sm border-0 h-100 settings-card-clickable">
                            <div class="card-body text-center py-5">
                                <div class="settings-card-icon icon-color-green"><i class="bi bi-credit-card"></i></div>
                                <h5 class="fw-semibold">Payment Accounts</h5>
                                <p class="text-muted mb-0">Manage EasyPaisa and Bank accounts for payments</p>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="/admin/settings/website" class="text-decoration-none">
                        <div class="card shadow-sm border-0 h-100 settings-card-clickable">
                            <div class="card-body text-center py-5">
                                <div class="settings-card-icon icon-color-violet"><i class="bi bi-globe"></i></div>
                                <h5 class="fw-semibold">Website Settings</h5>
                                <p class="text-muted mb-0">Manage site name, branding, contact info and social links</p>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="/admin/settings/packages" class="text-decoration-none">
                        <div class="card shadow-sm border-0 h-100 settings-card-clickable">
                            <div class="card-body text-center py-5">
                                <div class="settings-card-icon icon-color-indigo"><i class="bi bi-box-seam"></i></div>
                                <h5 class="fw-semibold">Packages</h5>
                                <p class="text-muted mb-0">Manage platform service packages and pricing</p>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="/settings" class="text-decoration-none">
                        <div class="card shadow-sm border-0 h-100 settings-card-clickable">
                            <div class="card-body text-center py-5">
                                <div class="settings-card-icon icon-color-amber"><i class="bi bi-person-gear"></i></div>
                                <h5 class="fw-semibold">Account Settings</h5>
                                <p class="text-muted mb-0">Security, password, and profile preferences</p>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>

@section Scripts {
    <script>
        function toggleProfileMenu() {
            var menu = document.getElementById('profileMenu');
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }
        document.addEventListener('click', function(e) {
            var pd = document.getElementById('profileDropdown');
            if (pd && !pd.contains(e.target)) {
                var m = document.getElementById('profileMenu');
                if (m) m.style.display = 'none';
            }
        });
    </script>
}
