@page "/admin/settings/accounts"
@model BoostingHub.frontend.Pages.Admin.Settings.Accounts.IndexModel
@using BoostingHub.backend.Common
@{
    ViewData["Title"] = "Payment Accounts";
    ViewData["BodyClass"] = "admin-page";
}

        <div class="admin-header">
            <h3><i class="bi bi-credit-card text-primary"></i> Payment Accounts</h3>
            <div class="admin-header-right">
                <button id="themeToggle" class="btn btn-sm btn-outline-primary me-3 border-0" aria-label="Toggle Theme">
                    <i class="bi bi-moon-stars fs-5"></i>
                </button>
                <div class="user-profile-dropdown" id="profileDropdown">
                    <span class="admin-user-badge" onclick="toggleProfileMenu()">
                        <i class="bi bi-person-circle"></i> Admin
                        <i class="bi bi-chevron-down" style="font-size:0.65rem;margin-left:2px;"></i>
                    </span>
                    <div class="profile-menu" id="profileMenu" style="display:none;">
                        <a href="/logout" class="profile-menu-item"><i class="bi bi-box-arrow-right"></i> Logout</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="admin-content">
            <div class="mb-3">
                <a href="/admin/settings" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to Settings</a>
            </div>
            <div class="card shadow-sm border-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-bank text-primary me-2"></i> Bank Accounts</h5>
                    @if (!Model.HasBankAccount)
                    {
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createAccountModal">
                            <i class="bi bi-plus-circle"></i> Add Bank Account
                        </button>
                    }
                    else
                    {
                        <span class="text-muted" style="font-size:0.85rem;"><i class="bi bi-check-circle text-success"></i> Bank account exists</span>
                    }
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="admin-table mb-0 align-middle">
                            <thead class="admin-thead">
                                <tr>
                                    <th>Bank Name</th>
                                    <th>Mobile Number</th>
                                    <th>CNIC</th>
                                    <th>Account Number</th>
                                    <th>Default</th>
                                    <th>Status</th>
                                    <th>Created</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var acc in Model.Accounts)
                                {
                                    <tr>
                                        <td><span class="admin-badge" style="background:rgba(59,130,246,0.15);color:#3B82F6;"><i class="bi bi-bank me-1"></i> @(acc.BankName ?? "—")</span></td>
                                        <td>@acc.MobileNumber</td>
                                        <td>@acc.Cnic</td>
                                        <td>@(acc.AccountNumber ?? "—")</td>
                                        <td>
                                            @if (acc.IsDefault)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-2">No</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2">@StatusHelper.AccountStatusToString(acc.Status)</span>
                                        </td>
                                        <td class="text-muted">@acc.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@acc.Id" style="display:inline;" onsubmit="return confirm('Delete this account?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.Accounts.Any())
                                {
                                    <tr><td colspan="8" class="text-center text-muted py-5">No bank account added yet. <a href="#" data-bs-toggle="modal" data-bs-target="#createAccountModal">Add one now</a>.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Create Account Modal -->
            <div class="modal fade" id="createAccountModal" tabindex="-1" aria-labelledby="createAccountModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg">
                        <div class="modal-header border-bottom-0">
                            <h5 class="modal-title fw-semibold" id="createAccountModalLabel"><i class="bi bi-bank text-primary"></i> Add Bank Account</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <form method="post" asp-page-handler="Create">
                                <input type="hidden" asp-for="Input.AccountTitle" value="Bank" />
                                <div class="mb-3">
                                    <label class="form-label fw-medium text-secondary">Bank Name</label>
                                    <select asp-for="Input.BankName" class="form-select" required>
                                        <option value="">Select Bank</option>
                                        <option value="Allied Bank Limited">Allied Bank Limited (ABL)</option>
                                        <option value="Askari Bank">Askari Bank</option>
                                        <option value="Bank Alfalah">Bank Alfalah</option>
                                        <option value="Bank Al Habib">Bank Al Habib</option>
                                        <option value="Bank of Punjab">Bank of Punjab (BOP)</option>
                                        <option value="Faysal Bank">Faysal Bank</option>
                                        <option value="Habib Bank Limited">Habib Bank Limited (HBL)</option>
                                        <option value="JS Bank">JS Bank</option>
                                        <option value="MCB Bank">MCB Bank</option>
                                        <option value="Meezan Bank">Meezan Bank</option>
                                        <option value="National Bank of Pakistan">National Bank of Pakistan (NBP)</option>
                                        <option value="Silk Bank">Silk Bank</option>
                                        <option value="Soneri Bank">Soneri Bank</option>
                                        <option value="Standard Chartered">Standard Chartered</option>
                                        <option value="Summit Bank">Summit Bank</option>
                                        <option value="United Bank Limited">United Bank Limited (UBL)</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-medium text-secondary">Account Number</label>
                                    <input asp-for="Input.AccountNumber" class="form-control" placeholder="Enter bank account number" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-medium text-secondary">Mobile Number</label>
                                    <input asp-for="Input.MobileNumber" class="form-control" type="tel" placeholder="03XX-XXXXXXX" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-medium text-secondary">CNIC</label>
                                    <input asp-for="Input.Cnic" class="form-control" placeholder="XXXXX-XXXXXXX-X" required />
                                </div>
                                <div class="mb-4 form-check">
                                    <input asp-for="Input.IsDefault" class="form-check-input" />
                                    <label class="form-check-label" asp-for="Input.IsDefault">Set as default account</label>
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary py-2"><i class="bi bi-save"></i> Save Bank Account</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

@section Scripts {
    <script src="~/js/site.js"></script>
    <script>
        @if (!string.IsNullOrEmpty(Model.TempData["Success"] as string))
        {
            <text>document.addEventListener('DOMContentLoaded', function() { showToast('@TempData["Success"]', 'success'); });</text>
        }
        @if (TempData["Error"] is string eMsg && !string.IsNullOrEmpty(eMsg))
        {
            <text>document.addEventListener('DOMContentLoaded', function() { showToast('@eMsg', 'danger'); });</text>
        }

        function toggleProfileMenu() {
            var menu = document.getElementById('profileMenu');
            menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
        }
        document.addEventListener('click', function(e) {
            var pd = document.getElementById('profileDropdown');
            if (pd && !pd.contains(e.target)) {
                var m = document.getElementById('profileMenu');
                if (m) m.style.display = 'none';
            }
        });


    </script>
}
