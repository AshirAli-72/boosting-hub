    @if (ViewData["UsesBlazor"] as bool? == true)
    {
        <script>
            // Suppress Blazor verbose console output
            window.Blazor = window.Blazor || {};
            if (typeof window.__blazorLogLevel === 'undefined') {
                // Silence Blazor information/warning logs shown in console
                var _origInfo = console.info;
                var _origWarn = console.warn;
                console.info = function() {
                    var msg = arguments[0];
                    if (typeof msg === 'string' && (
                        msg.indexOf('Normalizing') !== -1 ||
                        msg.indexOf('WebSockets transport') !== -1 ||
                        msg.indexOf('Long Polling') !== -1 ||
                        msg.indexOf('_blazor') !== -1
                    )) return;
                    _origInfo.apply(console, arguments);
                };
                console.warn = function() {
                    var msg = arguments[0];
                    if (typeof msg === 'string' && (
                        msg.indexOf('WebSocket') !== -1 ||
                        msg.indexOf('Long Polling') !== -1 ||
                        msg.indexOf('_blazor') !== -1 ||
                        msg.indexOf('SignalR') !== -1 ||
                        msg.indexOf('transport') !== -1
                    )) return;
                    _origWarn.apply(console, arguments);
                };
                window.__blazorLogLevel = true;
            }
        </script>
        <script src="/_framework/blazor.server.js"></script>
    }
    <script>
        function toggleMobileNav() {
            var nav = document.getElementById('headerNav');
            var overlay = document.getElementById('mobileNavOverlay');
            var btn = document.getElementById('mobileToggle');
            var open = nav.classList.toggle('open');
            if (overlay) overlay.classList.toggle('open', open);
            if (btn) {
                btn.classList.toggle('open', open);
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            }
            document.body.classList.toggle('nav-open', open);
        }
        document.addEventListener('click', function (e) {
            var nav = document.getElementById('headerNav');
            if (nav && nav.classList.contains('open') && nav.contains(e.target) && e.target.closest('a')) {
                toggleMobileNav();
            }
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                var nav = document.getElementById('headerNav');
                if (nav && nav.classList.contains('open')) toggleMobileNav();
            }
        });
        document.querySelectorAll('.header-nav a[href^="#"]').forEach(function (link) {
            link.addEventListener('click', function () {
                document.querySelectorAll('.header-nav a[href^="#"]').forEach(function (l) { l.classList.remove('active'); });
                link.classList.add('active');
            });
        });
        (function initNavScrollSpy() {
            var sectionIds = ['features', 'stats', 'how-earners', 'contact'];
            var links = document.querySelectorAll('.header-nav a[href^="#"]');
            if (!links.length) return;
            var sections = sectionIds.map(function (id) { return document.getElementById(id); }).filter(Boolean);
            if (!sections.length) return;
            function setActive(id) {
                links.forEach(function (link) {
                    link.classList.toggle('active', link.getAttribute('href') === '#' + id);
                });
            }
            if ('IntersectionObserver' in window) {
                var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) setActive(entry.target.id);
                    });
                }, { rootMargin: '-40% 0px -50% 0px', threshold: 0 });
                sections.forEach(function (section) { observer.observe(section); });
            }
        })();
        window.addEventListener('scroll', function () {
            var h = document.getElementById('landingHeader');
            if (h) h.classList.toggle('scrolled', window.scrollY > 40);
            var prog = document.getElementById('scrollProgress');
            if (prog) {
                var doc = document.documentElement;
                var max = doc.scrollHeight - window.innerHeight;
                prog.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
            }
        }, { passive: true });

        function toggleTheme() {
            const isLight = document.body.classList.toggle('light-mode');
            document.documentElement.classList.toggle('light-mode', isLight);
            localStorage.setItem('theme', isLight ? 'light' : 'dark');
            updateThemeButtons(isLight);
        }

        function updateThemeButtons(isLight) {
            document.querySelectorAll('.theme-toggle-btn').forEach(function (btn) {
                btn.classList.toggle('is-light', isLight);
            });
