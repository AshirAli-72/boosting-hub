            var totalAmount = 0;
            for (var s in iqServiceData) {
                var d = iqServiceData[s];
                if (d.selectedPkg) {
                    serviceNames.push(s);
                    totalQty += d.qty;
                    var pkgCurrency = d.pkgCurrency || 'USD';
                    var priceInPayCurrency = convertCurrency(d.unitPrice, pkgCurrency, payCurrency);
                    totalAmount += priceInPayCurrency * d.qty;
                }
            }
            if (serviceNames.length === 0) { alert('Please select a service.'); return; }

            var formData = new FormData();
            formData.append('fullName', name);
            formData.append('email', email);
            formData.append('platform', platform);
            formData.append('service', serviceNames.join(', '));
            formData.append('quantity', totalQty);
            formData.append('socialMediaUrl', url);
            formData.append('totalAmount', totalAmount);
            formData.append('description', description || '');
            formData.append('currency', payCurrency);
            formData.append('attachment', attachmentFile);

            try {
                if (selectedPayMethod !== 'stripe') {
                    var resp = await fetch('/api/orders', { method: 'POST', body: formData });
                    if (!resp.ok) {
                        var txt = await resp.text();
                        throw new Error(txt.substring(0, 300));
