        function updateOrderSummary() {
            var totalPkr = 0;
            var platform = document.getElementById('iq-platform').value;
            for (var s in iqServiceData) {
                var d = iqServiceData[s];
                if (d.selectedPkg && d.unitPrice > 0 && d.qty > 0) {
                    var pkgCurrency = d.pkgCurrency || 'USD';
                    var priceInPkr = convertCurrency(d.unitPrice, pkgCurrency, 'PKR');
                    totalPkr += priceInPkr * d.qty;
                }
            }
            var el = document.getElementById('iq-order-summary');
            if (totalPkr > 0) {
                el.style.animation = 'none';
                void el.offsetHeight;
                el.style.display = 'block';
                el.style.animation = '';
                document.getElementById('iq-total-price').textContent = formatPrice(totalPkr, 'PKR');
            } else {
                el.style.display = 'none';
