@using BoostingHub.backend.Services.Interfaces
@inject IWebsiteSettingService WebsiteSettingSvc
@{
    var wsResult = await WebsiteSettingSvc.GetAsync();
    var ws = wsResult.Data;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <base href="/" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ws?.SiteName ?? "Boosting Hub") - @ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="@(!string.IsNullOrEmpty(ws?.FaviconUrl) ? ws.FaviconUrl : Url.Content("~/favicon.ico"))" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (ViewData["PageType"]?.ToString() == "landing")
    {
        <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    }
    else if (ViewData["PageType"]?.ToString() == "auth")
    {
        <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    }
    else if (ViewData["BodyClass"]?.ToString() == "dashboard-page" || ViewData["BodyClass"]?.ToString() == "admin-page")
    {
        <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    }
    else if (ViewData["BodyClass"]?.ToString() == "user-dashboard-page")
    {
        <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
    <script>
        const savedTheme = localStorage.getItem('theme') || 'dark';
        if (savedTheme === 'light') {
            document.documentElement.classList.add('light-mode');
        }
    </script>
</head>
<body class="@ViewData["BodyClass"]">
    <script>
        if(localStorage.getItem('theme')==='light'){
            document.body.classList.add('light-mode');
        }
    </script>
    @if (ViewData["PageType"]?.ToString() == "landing")
    {
        <div class="page-loader" id="pageLoader" aria-hidden="true">
            <div class="page-loader-logo-wrap">
                <div class="page-loader-ring"></div>
                <div class="page-loader-logo"><i class="bi bi-rocket-takeoff"></i></div>
            </div>
            <div class="page-loader-brand">@(ws?.SiteName ?? "Boosting Hub")</div>
            <div class="page-loader-tag">Social Engagement Marketplace</div>
            <div class="page-loader-loading">Loading <span class="page-loader-dots"><span></span><span></span><span></span></span></div>
        </div>
        <noscript><style>.page-loader{display:none}</style></noscript>
        <script>
            (function () {
                var loader = document.getElementById('pageLoader');
                if (!loader) return;
                var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                if (reduced) { loader.style.display = 'none'; return; }
                var started = Date.now();
                var done = false;
                function hide() {
                    if (done) return;
                    done = true;
                    loader.classList.add('done');
                    setTimeout(function () { loader.style.display = 'none'; }, 600);
                }
                function finishAfterMin() {
                    var remaining = Math.max(0, 2200 - (Date.now() - started));
                    setTimeout(hide, remaining);
                }
                window.addEventListener('load', finishAfterMin);
                setTimeout(hide, 3200);
            })();
        </script>
        <header class="landing-header" id="landingHeader">
            <div class="scroll-progress" id="scrollProgress"></div>
            <div class="header-inner">
                <a href="/" class="header-logo">
                    <div class="header-logo-icon">
                        @if (!string.IsNullOrEmpty(ws?.LogoUrl))
                        {
                            <img src="@ws.LogoUrl" alt="@ws.SiteName" class="logo-img-full" />
                        }
                        else
                        {
                            <i class="bi bi-rocket-takeoff"></i>
                        }
                    </div>
                    <span class="header-logo-text">@(ws?.SiteName ?? "Boosting Hub")</span>
                </a>
                <nav class="header-nav" id="headerNav" aria-label="Main navigation">
                    <div class="mobile-nav-header">
                        <span class="mobile-nav-title">@(ws?.SiteName ?? "Boosting Hub")</span>
                        <div class="mobile-nav-header-actions">
                            <button type="button" class="mobile-nav-theme-btn" onclick="toggleTheme()" aria-label="Toggle theme">
                                <i class="bi bi-moon-fill mobile-theme-dark-icon"></i>
                                <i class="bi bi-sun-fill mobile-theme-light-icon"></i>
                            </button>
                            <button type="button" class="mobile-nav-close" onclick="toggleMobileNav()" aria-label="Close menu">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="mobile-nav-links">
                        <a href="#features"><i class="bi bi-stars"></i><span>Features</span></a>
                        <a href="#stats"><i class="bi bi-bar-chart-fill"></i><span>Stats</span></a>
                        <a href="#how-earners"><i class="bi bi-people-fill"></i><span>How It Works</span></a>
                        <a href="#contact"><i class="bi bi-envelope-fill"></i><span>Contact Us</span></a>
                    </div>
                    <div class="mobile-nav-cta">
                        <span class="mobile-nav-label">Account</span>
                        <a href="/login" class="btn-ghost"><i class="bi bi-box-arrow-in-right"></i><span>Login</span></a>
                        <a href="/register" class="btn-primary-solid"><i class="bi bi-person-plus-fill"></i><span>Sign Up</span></a>
                    </div>
                </nav>
                <div class="header-cta" id="headerCta">
                    <button class="theme-toggle-btn" id="landingThemeToggle" onclick="toggleTheme()" aria-label="Toggle Theme">
                        <span class="theme-toggle-icons">
                            <i class="bi bi-moon-fill dark-icon"></i>
                            <i class="bi bi-sun-fill light-icon"></i>
                        </span>
                    </button>
                    <a href="/login" class="btn-ghost"><i class="bi bi-box-arrow-in-right"></i><span>Login</span></a>
                    <a href="/register" class="btn-primary-solid"><i class="bi bi-person-plus-fill"></i><span>Sign Up</span></a>
                </div>
                <button class="mobile-toggle" id="mobileToggle" onclick="toggleMobileNav()" aria-label="Toggle menu" aria-expanded="false">
                    <span class="bar bar-1"></span>
                    <span class="bar bar-2"></span>
                    <span class="bar bar-3"></span>
                </button>
            </div>
            <div class="mobile-nav-overlay" id="mobileNavOverlay" onclick="toggleMobileNav()"></div>
        </header>

        <main>
            @RenderBody()

            <section class="hero" id="hero">
                <div class="hero-bg-glow"></div>
                <div class="hero-bg-glow-2"></div>
                <div class="hero-orb hero-orb-1"></div>
                <div class="hero-orb hero-orb-2"></div>
                <div class="hero-orb hero-orb-3"></div>
                <div class="hero-grid">
                    <div class="reveal reveal-left">
                        <div class="hero-badge"><i class="bi bi-lightning-fill"></i> Trusted by @((ViewData["LandingTotalUsers"] as int? ?? 0).ToString("N0"))+ creators <span class="badge-dot"></span></div>
                        <h1 class="hero-title">
                            @Html.Raw((ws?.HeroTitle ?? "Grow Your Social<br><span class=\"hero-title-gradient\">Engagement</span><br>Effortlessly").Replace("\n", "<br>"))
                        </h1>
                        <p class="hero-subtitle">
                            @(ws?.HeroSubtitle ?? "The premier marketplace connecting content creators with real, high-quality engagement. Boost your social presence with authentic likes, followers, and views.")
                        </p>
                        @if (!string.IsNullOrEmpty(ws?.HeroDescription))
                        {
                            <p class="hero-description">@ws.HeroDescription</p>
                        }
                        <div class="hero-actions">
                            <a href="#contact" class="btn-hero-primary">
                                <i class="bi bi-envelope-fill"></i> Contact Us
                            </a>
                            <a href="#features" class="btn-hero-secondary">
                                <i class="bi bi-play-circle"></i> See How It Works
                            </a>
                        </div>

                    </div>
                    <div class="hero-visual reveal reveal-right">
                        <div class="hero-card-mockup">
                            <div class="hero-card-header">
                                <div class="hero-card-dots"><span></span><span></span><span></span></div>
                                <div class="hero-card-avatar">
                                    <div class="hero-card-avatar-circle">JD</div>
                                    <span>@(User.Identity?.Name ?? "Guest User")</span>
                                </div>
                            </div>
                            <div class="hero-card-row">
                                <div class="hero-card-icon purple"><i class="bi bi-instagram"></i></div>
                                <div class="hero-card-content"><h4>Instagram Followers</h4><p>1,500 followers &bull; 2h ago</p></div>
                                <span class="hero-card-status live">Live</span>
                            </div>
                            <div class="hero-card-row">
                                <div class="hero-card-icon green"><i class="bi bi-youtube"></i></div>
                                <div class="hero-card-content"><h4>YouTube Views</h4><p>10,000 views &bull; 30m ago</p></div>
                                <span class="hero-card-status live">Live</span>
                            </div>
                            <div class="hero-card-row">
                                <div class="hero-card-icon orange"><i class="bi bi-tiktok"></i></div>
                                <div class="hero-card-content"><h4>TikTok Likes</h4><p>5,000 likes &bull; 1h ago</p></div>
                                <span class="hero-card-status pending">Pending</span>
                            </div>
                            <div class="hero-card-row">
                                <div class="hero-card-icon blue"><i class="bi bi-twitter-x"></i></div>
                                <div class="hero-card-content"><h4>X (Twitter) Followers</h4><p>3,000 followers &bull; 4h ago</p></div>
                                <span class="hero-card-status live">Live</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="section" id="features">
                    <div class="section-header reveal">
                    <div class="section-label"><i class="bi bi-stars"></i> Features</div>
                    <h2 class="section-title section-title-light">Everything You Need to Grow</h2>
                    <p class="section-subtitle">Powerful tools and real engagement to supercharge your social media presence across all major platforms.</p>
                </div>
                <div class="features-grid">
                    <div class="feature-card reveal reveal-left">
                        <div class="feature-icon purple"><i class="bi bi-shield-check"></i></div>
                        <h3>Real &amp; Authentic</h3>
                        <p>All engagement comes from real accounts. No bots, no fake profiles, guaranteed authentic growth.</p>
                    </div>
                    <div class="feature-card reveal reveal-left">
                        <div class="feature-icon green"><i class="bi bi-lightning-charge"></i></div>
                        <h3>Lightning Fast</h3>
                        <p>Orders start within minutes of placement. Our automated system delivers results at unprecedented speed.</p>
                    </div>
                    <div class="feature-card reveal reveal-left">
                        <div class="feature-icon blue"><i class="bi bi-graph-up-arrow"></i></div>
                        <h3>Smart Analytics</h3>
                        <p>Track your growth with detailed analytics, real-time reporting, and performance insights dashboard.</p>
                    </div>
                    <div class="feature-card reveal reveal-right">
                        <div class="feature-icon orange"><i class="bi bi-globe2"></i></div>
                        <h3>Multi-Platform</h3>
                        <p>Supporting Instagram, YouTube, TikTok, X (Twitter), Facebook, LinkedIn, and more major platforms.</p>
                    </div>
                    <div class="feature-card reveal reveal-right">
                        <div class="feature-icon pink"><i class="bi bi-lock-fill"></i></div>
                        <h3>Secure &amp; Private</h3>
                        <p>Your data is encrypted end-to-end. We never share your information with third parties.</p>
                    </div>
                    <div class="feature-card reveal reveal-right">
                        <div class="feature-icon teal"><i class="bi bi-headset"></i></div>
                        <h3>24/7 Support</h3>
                        <p>Our dedicated support team is available around the clock to help you with any questions or issues.</p>
                    </div>
                </div>
            </section>

            <section class="section-light" id="stats">
                    <div class="section-header reveal">
                    <div class="section-label"><i class="bi bi-bar-chart-fill"></i> Our Numbers</div>
                    <h2 class="section-title section-title-dark">Trusted by Creators Worldwide</h2>
                    <p class="section-subtitle section-subtitle-dark">Join thousands of satisfied content creators who trust @(ws?.SiteName ?? "Boosting Hub") for their social media growth.</p>
                </div>
                <div class="stats-grid">
                    <div class="stat-card reveal reveal-left"><div class="stat-number" data-target="@(ViewData["LandingTotalUsers"] as int? ?? 0)" data-suffix="+">0+</div><div class="stat-label">Users</div></div>
                    <div class="stat-card reveal"><div class="stat-number" data-target="@(ViewData["LandingTotalOrders"] as int? ?? 0)" data-suffix="+">0+</div><div class="stat-label">Orders</div></div>
                    <div class="stat-card reveal reveal-right"><div class="stat-number" data-target="@(ViewData["LandingCompletedTasks"] as int? ?? 0)" data-suffix="+">0+</div><div class="stat-label">Completed Orders</div></div>
                </div>
            </section>

            <!-- ── How It Works: Earners ── -->
            <section class="section" id="how-earners">
                    <div class="section-header reveal">
                    <div class="section-label"><i class="bi bi-cash-coin"></i> Earn Money</div>
                    <h2 class="section-title section-title-light">How Earners Work</h2>
                    <p class="section-subtitle">Complete simple social media tasks and earn real money. It's that easy.</p>
                </div>
                <div class="steps-grid">
                    <div class="step-card reveal reveal-left">
                        <div class="step-icon purple"><i class="bi bi-person-plus"></i></div>
                        <h3>Create Account</h3>
                        <p>Sign up for free in seconds. Link your social media accounts to get started.</p>
                    </div>
                    <div class="step-card reveal">
                        <div class="step-icon green"><i class="bi bi-list-task"></i></div>
                        <h3>Browse Tasks</h3>
                        <p>Explore available tasks like follows, likes, views, and comments across platforms.</p>
                    </div>
                    <div class="step-card reveal reveal-right">
                        <div class="step-icon blue"><i class="bi bi-check2-all"></i></div>
                        <h3>Complete &amp; Earn</h3>
                        <p>Finish tasks, submit proof, and get paid instantly to your wallet. Withdraw anytime.</p>
                    </div>
                </div>
            </section>

            <!-- ── How It Works: Order Givers ── -->
            <section class="section-light" id="how-orderers">
                    <div class="section-header reveal">
                    <div class="section-label"><i class="bi bi-rocket-takeoff"></i> Grow Faster</div>
                    <h2 class="section-title section-title-dark">How Order Givers Work</h2>
                    <p class="section-subtitle section-subtitle-dark">Place orders for real social media engagement. Our community handles the rest.</p>
                </div>
                <div class="steps-grid">
                    <div class="step-card light reveal reveal-left">
                        <div class="step-icon purple"><i class="bi bi-megaphone"></i></div>
                        <h3>Submit Requirements</h3>
                        <p>Choose your platform, service type, and package. Tell us what engagement you need.</p>
                    </div>
                    <div class="step-card light reveal">
                        <div class="step-icon green"><i class="bi bi-clipboard-check"></i></div>
                        <h3>Instant Activation</h3>
                        <p>Payment is confirmed instantly and tasks are auto-generated for our community of earners to complete.</p>
                    </div>
                    <div class="step-card light reveal reveal-right">
                        <div class="step-icon blue"><i class="bi bi-graph-up-arrow"></i></div>
                        <h3>Watch Growth</h3>
                        <p>Real users complete your tasks. Track progress on your dashboard and see real results.</p>
                    </div>
                </div>
            </section>

            <!-- ── Clients Section ── -->
            <section class="inquiry-section" id="place-order">
                    <div class="section-header reveal">
                    <div class="section-label"><i class="bi bi-cart-check-fill"></i> Place Your Order</div>
                    <h2 class="section-title section-title-light">Place Your Order</h2>
                    <p class="section-subtitle">Choose your Platform, Service, and Quantity — pay to confirm and tasks are auto-generated for our community to complete.</p>
                    <div id="iq-currency-badge" class="iq-currency-badge" title="Prices displayed in your local currency"></div>
                </div>

                <div class="inquiry-form-card reveal">
                    <div id="inquirySuccess" class="inquiry-success hidden">
                        <i class="bi bi-check-circle-fill"></i>&nbsp; Order submitted! Awaiting admin approval.
                    </div>
                    <div id="inquiryError" class="alert alert-danger inquiry-error hidden">
                        <i class="bi bi-exclamation-triangle-fill"></i>&nbsp; <span id="inquiryErrorText"></span>
                    </div>
                    <form id="inquiryForm" onsubmit="return false;">
                        <div class="inquiry-section-group">
                            <div class="inquiry-group-title"><i class="bi bi-person-badge"></i> Contact Information</div>
                            <div class="inquiry-grid">
                                <div class="inquiry-field">
                                    <label>Your Name <span>*</span></label>
                                    <input type="text" id="iq-name" placeholder="John Doe" required />
                                </div>
                                <div class="inquiry-field">
                                    <label>Email <span>*</span></label>
                                    <input type="email" id="iq-email" placeholder="john@example.com" required />
                                </div>
                            </div>
                        </div>

                        <div class="inquiry-section-group">
                            <div class="inquiry-group-title"><i class="bi bi-sliders"></i> Campaign Details</div>
                            <div class="inquiry-grid">
                                <div class="inquiry-field inquiry-field-full">
                                    <label>Platform <span>*</span></label>
                                    <select id="iq-platform" required onchange="onIqPlatformChange()">
                                        <option value="">Choose platform...</option>
                                    </select>
                                </div>
                                <div class="inquiry-field inquiry-field-full">
                                    <label>Services <span>*</span></label>
                                    <div class="iq-svc-dropdown" id="iq-svc-dropdown">
                                        <div class="iq-svc-dropdown-btn" onclick="toggleSvcDropdown()">
                                            <span id="iq-svc-label">Choose services...</span>
                                            <i class="bi bi-chevron-down"></i>
                                        </div>
                                        <div class="iq-svc-dropdown-menu" id="iq-svc-menu"></div>
                                    </div>
                                </div>
                                <div class="inquiry-field inquiry-field-full hidden" id="iq-service-qty-container">
                                    <label>Service Quantities <span>*</span></label>
                                    <div id="iq-service-qty-area"></div>
                                </div>
                                <div class="inquiry-field inquiry-field-full">
                                    <label>Target URL <span>*</span></label>
                                    <input type="url" id="iq-url" placeholder="https://instagram.com/your-profile" required />
                                </div>
                                <div class="inquiry-field inquiry-field-full">
                                    <label>Attachment <span>*</span> <small>(Screenshot of current stats before starting, e.g. followers/following count, likes, views — so we can verify completion)</small></label>
                                    <div class="file-upload-wrapper" id="iq-attachment-wrapper">
                                        <input type="file" id="iq-attachment" accept="image/*,.pdf,.doc,.docx" required hidden onchange="updateFileName(this)" />
                                        <label for="iq-attachment" class="file-upload-label">
                                            <div class="file-upload-icon"><i class="bi bi-cloud-arrow-up-fill"></i></div>
                                            <div class="file-upload-text">
                                                <div class="file-upload-title">Click to upload or drag &amp; drop</div>
                                                <div class="file-upload-hint" id="iq-attachment-hint">PNG, JPG, WEBP, PDF up to 10MB</div>
                                            </div>
                                        </label>
                                        <div class="file-preview hidden" id="iq-attachment-preview">
                                            <img id="iq-attachment-img" src="" alt="Preview" />
                                            <div class="file-preview-info">
                                                <div class="file-preview-name" id="iq-attachment-name">—</div>
                                                <div class="file-preview-size" id="iq-attachment-size">—</div>
                                            </div>
                                            <button type="button" class="file-preview-remove" onclick="removeAttachment()" aria-label="Remove file">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="inquiry-field inquiry-field-full">
                                    <label>Description <small>(optional)</small></label>
                                    <textarea id="iq-description" rows="3" placeholder="Tell us more about what you need..."></textarea>
                                </div>
                            </div>
                        </div>

                        <div id="iq-services-area"></div>

                        <div id="iq-order-summary" class="iq-order-summary hidden">
                            <div class="iq-summary-row">
                                <div>
                                    <div class="iq-summary-label">Total Amount</div>
                                    <div id="iq-total-price" class="iq-total-price">0.00</div>
                                </div>
                            </div>
                        </div>

                        <button type="button" id="inquirySubmitBtn" class="btn-hero-primary w-100 mt-3 justify-content-center" onclick="openPaymentModal()">
                            <i class="bi bi-credit-card"></i> Proceed to Payment
                        </button>
                    </form>
                </div>

                <!-- ── Voucher Lookup ── -->
                <div id="voucherLookupCard">
                    <div class="inquiry-form-card reveal mt-32">
                        <div class="inquiry-section-group border-bottom-0">
                            <div class="voucher-toggle-header" onclick="toggleVoucherLookup()">
                                <i class="bi bi-file-earmark-text"></i>
                                <span class="voucher-toggle-title">Already Have a Voucher?</span>
                                <span id="voucherLookupToggleIcon" class="voucher-toggle-arrow"><i class="bi bi-chevron-down"></i></span>
                            </div>
                            <div id="voucherLookupBody" class="hidden">
                                <div id="voucherLookupSuccess" class="voucher-msg voucher-msg-success hidden"></div>
                                <div id="voucherLookupError" class="voucher-msg voucher-msg-error hidden"><span id="voucherLookupErrorText"></span></div>

                                <div id="voucherLookupStep1">
                                    <div class="inquiry-section-group iq-group-flush">
                                        <div class="inquiry-group-title"><i class="bi bi-upc-scan"></i> Enter Voucher Number</div>
                                        <div class="inquiry-grid">
                                            <div class="inquiry-field flex-grow-1">
                                                <label>Voucher Number <span>*</span></label>
                                                <input type="text" id="voucherInput" placeholder="VCH-2026-00001" required />
                                            </div>
                                            <div class="inquiry-field flex-none align-self-end">
                                                <button type="button" class="btn-hero-primary voucher-lookup-btn" onclick="lookupVoucher()" id="voucherLookupBtn">
                                                    <i class="bi bi-search"></i> Look Up
                                                </button>
                                            </div>
                                        </div>
                                        <p class="voucher-help-text">Enter the voucher number you received when downloading the payment voucher. We'll load your order details.</p>
                                    </div>
                                </div>

                                <div id="voucherLookupStep2" class="hidden">
                                    <div class="inquiry-section-group iq-group-flush">
                                        <div class="inquiry-group-title"><i class="bi bi-receipt"></i> Order Details</div>
                                        <div class="vl-details-card">
                                            <div class="vl-row">
                                                <span class="vl-label">Voucher No.</span>
                                                <strong id="vl-voucher" class="vl-value vl-value-strong">-</strong>
                                            </div>
                                            <div class="vl-row">
                                                <span class="vl-label">Client</span>
                                                <strong id="vl-name" class="vl-value">-</strong>
                                            </div>
                                            <div class="vl-row">
                                                <span class="vl-label">Platform</span>
                                                <strong id="vl-platform" class="vl-value">-</strong>
                                            </div>
                                            <div class="vl-row">
                                                <span class="vl-label">Services</span>
                                                <strong id="vl-services" class="vl-value">-</strong>
                                            </div>
                                            <div class="vl-row no-border">
                                                <span class="vl-label">Quantity</span>
                                                <strong id="vl-qty" class="vl-value">-</strong>
                                            </div>
                                            <div class="vl-total-row">
                                                <span class="vl-total-label">Total Amount</span>
                                                <strong id="vl-total" class="vl-total">-</strong>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="inquiry-section-group voucher-submit-card iq-group-flush mt-24">
                                        <div class="inquiry-group-title"><i class="bi bi-cloud-arrow-up-fill"></i> Submit Paid Voucher</div>
