            'NGN': 0.18, 'PHP': 5.0, 'IDR': 0.018, 'MYR': 61,
            'THB': 8.0, 'EGP': 5.9, 'ZAR': 15.5, 'MXN': 16.5,
            'KWD': 930, 'QAR': 78, 'BHD': 755, 'OMR': 742
        };

        function convertCurrency(amount, fromCurrency, toCurrency) {
            if (fromCurrency === toCurrency) return amount;
            var fromRate = iqPkrRates[fromCurrency];
            var toRate = iqPkrRates[toCurrency];
            if (!fromRate || !toRate) return amount;
            var inPkr = amount * fromRate;
            return inPkr / toRate;
        }

        function formatPrice(amount, fromCurrency) {
            fromCurrency = fromCurrency || iqBaseCurrency;
