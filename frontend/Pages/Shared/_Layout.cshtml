        document.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            updateThemeSwitches(savedTheme === 'light');

            function initScrollReveal() {
                var els = document.querySelectorAll('.reveal');
                if (!els.length) return;
                if (!('IntersectionObserver' in window)) {
                    els.forEach(function (el) { el.classList.add('visible'); });
                    return;
                }
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('visible');
                            io.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
                els.forEach(function (el) { io.observe(el); });
            }
            initScrollReveal();

            function wireDropZone(wrapperId, inputId, updateVariant) {
                const wrapper = document.getElementById(wrapperId);
                if (!wrapper) return;
                ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(ev => {
                    wrapper.addEventListener(ev, e => { e.preventDefault(); e.stopPropagation(); });
                });
                ['dragenter', 'dragover'].forEach(ev => {
                    wrapper.addEventListener(ev, () => wrapper.classList.add('is-dragging'));
                });
                ['dragleave', 'drop'].forEach(ev => {
                    wrapper.addEventListener(ev, () => wrapper.classList.remove('is-dragging'));
                });
                wrapper.addEventListener('drop', e => {
                    const dt = e.dataTransfer;
                    const files = dt.files;
                    if (files && files[0]) {
                        const input = document.getElementById(inputId);
                        const dt2 = new DataTransfer();
                        dt2.items.add(files[0]);
                        input.files = dt2.files;
                        updateFileName(input, updateVariant);
                    }
                });
            }

            wireDropZone('iq-attachment-wrapper', 'iq-attachment', undefined);
            wireDropZone('vl-paidVoucher-wrapper', 'vl-paidVoucherFile', 'vl-paidVoucherFile');

            var counters = document.querySelectorAll('.stat-number[data-target]');
            if (counters.length) {
                function animateCounter(el) {
                    var target = parseFloat(el.getAttribute('data-target')) || 0;
                    var suffix = el.getAttribute('data-suffix') || '';
                    var duration = 1800;
                    var start = null;
                    function step(ts) {
                        if (!start) start = ts;
                        var p = Math.min((ts - start) / duration, 1);
                        var eased = 1 - Math.pow(1 - p, 3);
                        el.textContent = Math.round(target * eased).toLocaleString('en-US') + suffix;
                        if (p < 1) requestAnimationFrame(step);
                    }
                    requestAnimationFrame(step);
                }
                if ('IntersectionObserver' in window) {
                    var counterIO = new IntersectionObserver(function (entries) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                animateCounter(entry.target);
                                counterIO.unobserve(entry.target);
                            }
                        });
                    }, { threshold: 0.4 });
                    counters.forEach(function (c) { counterIO.observe(c); });
                } else {
                    counters.forEach(animateCounter);
                }
            }
        });

