        async function lookupVoucher() {
            var voucherNo = document.getElementById('voucherInput').value.trim();
            if (!voucherNo) { alert('Please enter a voucher number.'); return; }

            var btn = document.getElementById('voucherLookupBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Looking up...';

            document.getElementById('voucherLookupError').style.display = 'none';

            try {
                var resp = await fetch('/api/orders/lookup/' + encodeURIComponent(voucherNo));
                if (!resp.ok) {
                    var errData = await resp.json();
                    throw new Error(errData.message || 'Voucher not found');
                }
                var data = await resp.json();

                window.__vlOrderId = data.id;
                document.getElementById('vl-voucher').textContent = data.voucherNo;
                document.getElementById('vl-name').textContent = data.fullName || '-';
                document.getElementById('vl-platform').textContent = data.platform || '-';
                document.getElementById('vl-services').textContent = data.service || '-';
                document.getElementById('vl-qty').textContent = data.quantity || '-';

                var sym = iqCurrencySymbols[payCurrency] || (data.currency === 'PKR' ? 'Rs.' : '$');
                document.getElementById('vl-total').textContent = sym + ' ' + parseFloat(data.totalAmount || 0).toFixed(2);

                document.getElementById('voucherLookupStep2').style.display = 'block';

            } catch(err) {
                document.getElementById('voucherLookupErrorText').textContent = err.message || 'Failed to look up voucher.';
                document.getElementById('voucherLookupError').style.display = 'flex';
                setTimeout(function() { document.getElementById('voucherLookupError').style.display = 'none'; }, 2000);
            }
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-search"></i> Look Up';
        }

        async function submitPaidVoucherFromLanding() {
            var fileInput = document.getElementById('vl-paidVoucherFile');
            if (!fileInput || !fileInput.files.length) {
                alert('Please upload your payment receipt/screenshot.');
                return;
            }
            if (!window.__vlOrderId) {
                alert('No order found. Please look up your voucher first.');
                return;
            }
            var btn = document.getElementById('vl-submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Submitting...';

            var formData = new FormData();
            formData.append('paidAmount', document.getElementById('vl-total').textContent.replace(/[^0-9.]/g, ''));
            formData.append('paymentMethod', 'Bank Transfer');
            formData.append('paidVoucher', fileInput.files[0]);

            try {
                var resp = await fetch('/api/orders/' + window.__vlOrderId + '/upload-paid-voucher', { method: 'POST', body: formData });
                var result = await resp.json();
                if (!resp.ok) throw new Error(result.message || 'Failed');

                document.getElementById('voucherLookupSuccess').style.display = 'flex';
                document.getElementById('voucherLookupSuccess').innerHTML = '<i class="bi bi-check-circle-fill"></i> Payment proof submitted! Awaiting admin verification.';
                document.getElementById('voucherLookupStep2').style.display = 'none';
                document.getElementById('voucherLookupStep1').style.display = 'block';
                document.getElementById('voucherInput').value = '';
                fileInput.value = '';
                window.__vlOrderId = null;

                setTimeout(function() {
                    document.getElementById('voucherLookupSuccess').style.display = 'none';
                }, 6000);

            } catch(err) {
                alert(err.message || 'Failed to submit payment proof.');
            }
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-cloud-arrow-up-fill"></i> Submit Paid Voucher';
        }

        async function confirmPayment() {
            if (!selectedPayMethod) {
                alert('Please select a payment method to continue.');
                return;
            }
            var btn = document.getElementById('payConfirmBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Processing...';

            var name = document.getElementById('iq-name').value.trim();
            var email = document.getElementById('iq-email').value.trim();
            var platform = document.getElementById('iq-platform').value;
            var url = document.getElementById('iq-url').value.trim();
            var description = document.getElementById('iq-description').value.trim();
            var attachmentInput = document.getElementById('iq-attachment');
            var attachmentFile = attachmentInput && attachmentInput.files.length > 0 ? attachmentInput.files[0] : null;

            if (!attachmentFile) {
                alert('Please upload a screenshot of your current stats before placing the order.');
                if (attachmentInput) attachmentInput.focus();
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-lock-fill"></i> Confirm & Pay';
                return;
