        function onServiceQtyChange(service) {
            var qty = parseInt(document.getElementById('iq-qty-' + service).value) || 0;
            iqServiceData[service].qty = qty;
            if (qty > 0 && iqServiceData[service].unitPrice > 0) {
                var pkgCurrency = iqServiceData[service].pkgCurrency || 'USD';
                var priceInPkr = convertCurrency(iqServiceData[service].unitPrice, pkgCurrency, 'PKR');
                iqServiceData[service].price = priceInPkr * qty;
            } else {
                iqServiceData[service].price = 0;
