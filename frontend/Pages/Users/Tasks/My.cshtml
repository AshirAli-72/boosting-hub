@page "/my-tasks"
@model BoostingHub.frontend.Pages.Users.Tasks.MyModel
@{
    ViewData["Title"] = "My Tasks";
    ViewData["BodyClass"] = "user-dashboard-page";
}

        <div class="admin-header">
            <h3><i class="bi bi-check2-square text-primary"></i> My Tasks</h3>
            <div class="admin-header-right">
                <button id="themeToggle" class="btn btn-sm btn-outline-primary me-3 border-0" aria-label="Toggle Theme">
                    <i class="bi bi-moon-stars fs-5"></i>
                </button>
                <div class="user-profile-dropdown" id="profileDropdown">
                    <span class="admin-user-badge" onclick="toggleProfileMenu()">
                        <i class="bi bi-person-circle"></i> @Model.UserName
                        <i class="bi bi-chevron-down profile-dropdown-caret"></i>
                    </span>
                    <div class="profile-menu hidden" id="profileMenu">
                        <a href="/logout" class="profile-menu-item"><i class="bi bi-box-arrow-right"></i> Logout</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="admin-content">
            <component type="typeof(BoostingHub.backend.Components.Tasks.MyTasks)" render-mode="ServerPrerendered" param-UserId="@Model.UserId" />
        </div>

@section Styles {
    <link rel="stylesheet" href="~/css/tasks.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        console.log('My Tasks scripts loaded');

        /* toggle profile menu */
        document.addEventListener('click', function(e) {
            var pd = document.getElementById('profileDropdown');
            if (pd && pd.contains(e.target) && e.target.closest('.admin-user-badge')) {
                var m = document.getElementById('profileMenu');
                if (m) m.style.display = m.style.display === 'block' ? 'none' : 'block';
                return;
            }
            if (pd && !pd.contains(e.target)) {
                var m = document.getElementById('profileMenu');
                if (m) m.style.display = 'none';
            }
        });

        /* â”€â”€ Proof form modal â”€â”€ */
        function showProofForm(taskId, taskUrl) {
            var overlay = document.createElement('div');
            overlay.id = 'proof-overlay';
            overlay.className = 'proof-overlay';
            overlay.innerHTML = [
                '<div class="task-modal-box">',
                '  <h5 class="task-modal-title"><i class="bi bi-upload text-primary me-2"></i>Submit Proof</h5>',
                '  <div id="pf-error" class="task-modal-error"></div>',
                '  <div class="task-modal-field">',
                '    <label class="task-modal-label">Proof URL</label>',
                '    <input type="url" id="pf-url" class="form-control task-modal-input" placeholder="https://imgur.com/screenshot.png" />',
                '  </div>',
                '  <div class="task-modal-footer">',
                '    <label class="task-modal-label">Screenshot <span class="task-modal-danger-text">*</span></label>',
                '    <div class="file-upload-wrapper" id="pf-wrapper">',
                '      <input type="file" id="pf-file" accept="image/png,image/jpeg,image/jpg,image/webp" hidden onchange="updateProofFileName(this)" />',
                '      <label for="pf-file" class="file-upload-label">',
                '        <div class="file-upload-icon"><i class="bi bi-cloud-arrow-up-fill"></i></div>',
                '        <div class="file-upload-text">',
                '          <div class="file-upload-title">Click to upload or drag &amp; drop</div>',
                '          <div class="file-upload-hint" id="pf-hint">PNG, JPG, WEBP up to 5MB</div>',
                '        </div>',
                '      </label>',
                '    </div>',
                '  </div>',
                '  <div class="task-modal-actions">',
                '    <button type="button" class="btn btn-secondary task-modal-cancel" onclick="closeProofForm()">Cancel</button>',
                '    <button type="button" class="btn btn-primary" id="pf-submit">Submit</button>',
                '  </div>',
                '</div>'
            ].join('\n');
            document.body.appendChild(overlay);
            wirePfDropZone();
            document.getElementById('pf-submit').onclick = function() { submitProof(taskId, taskUrl); };
        }

        function updateProofFileName(input) {
            var hint = document.getElementById('pf-hint');
            if (input.files && input.files[0]) {
                var file = input.files[0];
                var kb = file.size / 1024;
                var size = kb > 1024 ? (kb / 1024).toFixed(2) + ' MB' : kb.toFixed(1) + ' KB';
                if (hint) hint.textContent = file.name + '  (' + size + ')';
            } else if (hint) {
                hint.textContent = 'PNG, JPG, WEBP up to 5MB';
            }
        }

        function wirePfDropZone() {
            var wrapper = document.getElementById('pf-wrapper');
            if (!wrapper) return;
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(function(ev) {
                wrapper.addEventListener(ev, function(e) { e.preventDefault(); e.stopPropagation(); });
            });
            ['dragenter', 'dragover'].forEach(function(ev) {
                wrapper.addEventListener(ev, function() { wrapper.classList.add('is-dragging'); });
            });
            ['dragleave', 'drop'].forEach(function(ev) {
                wrapper.addEventListener(ev, function() { wrapper.classList.remove('is-dragging'); });
            });
            wrapper.addEventListener('drop', function(e) {
                var dt = e.dataTransfer;
                var files = dt.files;
                if (files && files[0]) {
                    var input = document.getElementById('pf-file');
                    var dt2 = new DataTransfer();
                    dt2.items.add(files[0]);
                    input.files = dt2.files;
                    updateProofFileName(input);
                }
            });
        }

        function closeProofForm() {
            var el = document.getElementById('proof-overlay');
            if (el) el.remove();
        }

        function showPfError(msg) {
            var el = document.getElementById('pf-error');
            if (el) { el.textContent = msg; el.style.display = 'block'; }
        }

        async function submitProof(taskId, taskUrl) {
            var fileInput = document.getElementById('pf-file');
            var file = fileInput ? fileInput.files[0] : null;
            if (!file) { showPfError('Please select a screenshot file to upload.'); return; }
            if (file.size > 5 * 1024 * 1024) { showPfError('File size must be under 5 MB.'); return; }
            document.getElementById('pf-error').style.display = 'none';
            var btn = document.getElementById('pf-submit');
            btn.disabled = true; btn.innerHTML = 'Submitting...';
            try {
                var fd = new FormData();
                fd.append('taskId', taskId);
                fd.append('proofUrl', document.getElementById('pf-url').value.trim());
                fd.append('proofFile', file);
                var resp = await fetch('/my-tasks?handler=SubmitProof', { method: 'POST', body: fd });
                if (!resp.ok) {
                    var bodyText = await resp.text();
                    console.error('Server returned', resp.status, bodyText.substring(0, 500));
                    showPfError('Server error ' + resp.status);
                    btn.disabled = false; btn.innerHTML = 'Submit';
                    return;
                }
                var data = await resp.json();
                if (data.success) {
                    closeProofForm();
                    location.reload();
                } else {
                    showPfError(data.message || 'Failed');
                    btn.disabled = false; btn.innerHTML = 'Submit';
                }
            } catch (e) {
                console.error('Proof submit error:', e);
                showPfError('Network error — check console (F12) for details');
                btn.disabled = false; btn.innerHTML = 'Submit';
            }
        }

        /* â”€â”€ Event delegation: click on any submit-proof-btn â”€â”€ */
        document.addEventListener('click', function(e) {
            var btn = e.target.closest('.submit-proof-btn');
            if (btn) {
                var taskId = btn.getAttribute('data-task-id');
                var taskUrl = btn.getAttribute('data-task-url') || '';
                console.log('Submit Proof clicked, taskId:', taskId);
                showProofForm(taskId, taskUrl);
            }
        });
    </script>
}
