@page "/wallet"
@model BoostingHub.frontend.Pages.Users.Wallet.IndexModel
@using BoostingHub.backend.Common
@{
    ViewData["Title"] = "Wallet";
    ViewData["BodyClass"] = "user-dashboard-page";
}

        <div class="admin-header">
            <h3><i class="bi bi-wallet2 text-primary"></i> Wallet</h3>
            <div class="admin-header-right">
                <button id="themeToggle" class="btn btn-sm btn-outline-primary me-3 border-0" aria-label="Toggle Theme">
                    <i class="bi bi-moon-stars fs-5"></i>
                </button>
                <div class="user-profile-dropdown" id="profileDropdown">
                    <span class="admin-user-badge" onclick="toggleProfileMenu()">
                        <i class="bi bi-person-circle"></i> User
                        <i class="bi bi-chevron-down" style="font-size:0.65rem;margin-left:2px;"></i>
                    </span>
                    <div class="profile-menu" id="profileMenu" style="display:none;">
                        <a href="/logout" class="profile-menu-item"><i class="bi bi-box-arrow-right"></i> Logout</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="admin-content">
            <div class="card shadow-sm border-0">
                <div class="card-header">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-wallet2 text-primary me-2"></i> Wallet Overview</h5>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle admin-table">
                                <thead class="admin-thead">
                                <tr>
                                    <th>Total Balance</th>
                                    <th>Currency</th>
                                    <th>Withdrawn</th>
                                    <th>Created At</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold fs-5" id="displayBalance">@Model.WalletData.Currency @Model.WalletData.TotalBalance.ToString("N2")</td>
                                     <td>
                                        <select class="form-select form-select-sm currency-select" id="currencySelect" onchange="changeCurrency(this.value)">
                                            <option value="USD" selected="@(Model.WalletData.Currency == "USD")">$ USD</option>
                                            <option value="EUR" selected="@(Model.WalletData.Currency == "EUR")">€ EUR</option>
                                            <option value="GBP" selected="@(Model.WalletData.Currency == "GBP")">£ GBP</option>
                                            <option value="PKR" selected="@(Model.WalletData.Currency == "PKR")">₨ PKR</option>
                                            <option value="INR" selected="@(Model.WalletData.Currency == "INR")">₹ INR</option>
                                            <option value="BDT" selected="@(Model.WalletData.Currency == "BDT")">৳ BDT</option>
                                            <option value="SAR" selected="@(Model.WalletData.Currency == "SAR")">﷼ SAR</option>
                                            <option value="AED" selected="@(Model.WalletData.Currency == "AED")">د.إ AED</option>
                                            <option value="TRY" selected="@(Model.WalletData.Currency == "TRY")">₺ TRY</option>
                                            <option value="NGN" selected="@(Model.WalletData.Currency == "NGN")">₦ NGN</option>
                                            <option value="JPY" selected="@(Model.WalletData.Currency == "JPY")">¥ JPY</option>
                                            <option value="CNY" selected="@(Model.WalletData.Currency == "CNY")">¥ CNY</option>
                                            <option value="KRW" selected="@(Model.WalletData.Currency == "KRW")">₩ KRW</option>
                                            <option value="PHP" selected="@(Model.WalletData.Currency == "PHP")">₱ PHP</option>
                                            <option value="IDR" selected="@(Model.WalletData.Currency == "IDR")">Rp IDR</option>
                                            <option value="MYR" selected="@(Model.WalletData.Currency == "MYR")">RM MYR</option>
                                            <option value="THB" selected="@(Model.WalletData.Currency == "THB")">฿ THB</option>
                                            <option value="EGP" selected="@(Model.WalletData.Currency == "EGP")">E£ EGP</option>
                                            <option value="ZAR" selected="@(Model.WalletData.Currency == "ZAR")">R ZAR</option>
                                            <option value="MXN" selected="@(Model.WalletData.Currency == "MXN")">Mex$ MXN</option>
                                        </select>
                                    </td>
                                    <td id="displayWithdrawn">@Model.WalletData.Currency @Model.WalletData.Withdrawn.ToString("N2")</td>
                                    <td>@Model.WalletData.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (Model.WalletData.Status == "Active")
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                                            <i class="bi bi-box-arrow-up"></i> Withdraw
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

<!-- Withdraw Modal -->
<div class="modal fade" id="withdrawModal" tabindex="-1" aria-labelledby="withdrawModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-semibold" id="withdrawModalLabel"><i class="bi bi-box-arrow-up text-warning"></i> Withdraw Funds</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                @if (Model.WalletData.TotalBalance <= 0)
                {
                    <div class="alert alert-warning mb-4 py-2 small"><i class="bi bi-exclamation-triangle"></i> Your balance is @Model.WalletData.Currency 0.00. Withdrawal is not possible.</div>
                }
                <form method="post" asp-page-handler="Withdraw">
                    <div class="mb-4">
                        <label class="form-label fw-medium text-secondary">Withdrawal Method</label>
                        <div class="p-3 rounded border bg-light">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-credit-card fs-4 text-primary me-3"></i>
                                <div>
                                    <strong>EasyPaisa</strong>
                                    @if (Model.DefaultAccount != null)
                                    {
                                        <div class="text-muted small">@Model.DefaultAccount.AccountTitle - @Model.DefaultAccount.MobileNumber</div>
                                    }
                                    else
                                    {
                                        <div class="text-danger small">No account found. <a href="/user/accounts">Add one</a>.</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="WithdrawAmount" class="form-label fw-medium text-secondary">Amount (<span id="modalCurrencySymbol">$</span>)</label>
                        <input asp-for="WithdrawAmount" class="form-control" type="number" step="0.01" min="0.01" placeholder="Enter amount" />
                        <span asp-validation-for="WithdrawAmount" class="text-danger small"></span>
                        <div class="text-muted small mt-1">Available balance: <span id="modalBalance">@Model.WalletData.Currency @Model.WalletData.TotalBalance.ToString("N2")</span></div>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-warning py-2" @(Model.DefaultAccount == null ? "disabled" : "")>
                            <i class="bi bi-send"></i> Submit Withdraw
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js"></script>
    <script>
        var baseBalance = @Model.WalletData.TotalBalance;
        var baseWithdrawn = @Model.WalletData.Withdrawn;
        var baseCurrency = '@Model.WalletData.Currency';
        if (!baseCurrency) baseCurrency = 'USD';
        var displayCurrency = localStorage.getItem('walletDisplayCurrency') || baseCurrency;

        var currencySymbols = {
            USD:'$', EUR:'€', GBP:'£', PKR:'₨', INR:'₹', BDT:'৳',
            SAR:'﷼', AED:'د.إ', TRY:'₺', NGN:'₦', JPY:'¥', CNY:'¥',
            KRW:'₩', PHP:'₱', IDR:'Rp', MYR:'RM', THB:'฿', EGP:'E£',
            ZAR:'R', MXN:'Mex$'
        };

        function getSym(c) { return currencySymbols[c] || '$'; }

        function convertAmount(amount, from, to) {
            if (from === to) return amount;
            var fromRate = window.__pkrRates[from];
            var toRate = window.__pkrRates[to];
            if (!fromRate || !toRate) return amount;
            var inPkr = amount * fromRate;
            return Math.round((inPkr / toRate) * 100) / 100;
        }

        function formatCur(amount, currency) {
            return getSym(currency) + ' ' + parseFloat(amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function updateDisplay() {
            var bal = convertAmount(baseBalance, baseCurrency, displayCurrency);
            var wd = convertAmount(baseWithdrawn, baseCurrency, displayCurrency);
            document.getElementById('displayBalance').textContent = formatCur(bal, displayCurrency);
            document.getElementById('displayWithdrawn').textContent = formatCur(wd, displayCurrency);
            document.getElementById('modalCurrencySymbol').textContent = getSym(displayCurrency);
            document.getElementById('modalBalance').textContent = formatCur(bal, displayCurrency);
        }

        function syncDropdown() {
            var sel = document.getElementById('currencySelect');
            if (sel && displayCurrency) sel.value = displayCurrency;
        }

        async function changeCurrency(currency) {
            displayCurrency = currency;
            localStorage.setItem('walletDisplayCurrency', currency);
            document.getElementById('currencySelect').value = currency;
            updateDisplay();
            try {
                await fetch('/wallet?handler=ChangeCurrency&currency=' + encodeURIComponent(currency), {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
                });
            } catch(e) {}
        }

        (async function init() {
            if (!localStorage.getItem('walletDisplayCurrency')) {
                try {
                    var currency = null;
                    if (typeof window.__getUserCurrency === 'function') {
                        currency = await window.__getUserCurrency();
                    }
                    if (currency && currency !== baseCurrency) {
                        displayCurrency = currency;
                        localStorage.setItem('walletDisplayCurrency', displayCurrency);
                        await fetch('/wallet?handler=ChangeCurrency&currency=' + encodeURIComponent(displayCurrency), {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
                        });
                    }
                } catch(e) {}
            }
            syncDropdown();
            updateDisplay();
        })();

        function toggleProfileMenu() {
            var menu = document.getElementById('profileMenu');
            menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
        }
        document.addEventListener('click', function(e) {
            var pd = document.getElementById('profileDropdown');
            if (pd && !pd.contains(e.target)) {
                var m = document.getElementById('profileMenu');
                if (m) m.style.display = 'none';
            }
        });

        @if (TempData["Success"] != null)
        {
            <text>document.addEventListener('DOMContentLoaded', function() { showToast('@TempData["Success"]', 'success'); });</text>
        }
        @if (TempData["Error"] is string eMsg && !string.IsNullOrEmpty(eMsg))
        {
            <text>document.addEventListener('DOMContentLoaded', function() { showToast('@eMsg', 'danger'); });</text>
        }

        function showToast(message, type) {
            var existing = document.querySelector('.bh-toast-container');
            if (!existing) {
                existing = document.createElement('div');
                existing.className = 'bh-toast-container';
                existing.style.cssText = 'position:fixed;top:20px;left:20px;z-index:99999;display:flex;flex-direction:column;gap:10px;max-width:400px;';
                document.body.appendChild(existing);
            }
            var toast = document.createElement('div');
            var colorMap = { success: '#10B981', danger: '#EF4444', warning: '#F59E0B', info: '#3B82F6' };
            var bgMap = { success: 'rgba(16,185,129,0.12)', danger: 'rgba(239,68,68,0.12)', warning: 'rgba(245,158,11,0.12)', info: 'rgba(59,130,246,0.12)' };
            var iconMap = { success: 'check-circle-fill', danger: 'exclamation-triangle-fill', warning: 'exclamation-circle-fill', info: 'info-circle-fill' };
            var color = colorMap[type] || '#10B981';
            var bg = bgMap[type] || 'rgba(16,185,129,0.12)';
            var icon = iconMap[type] || 'check-circle-fill';
            toast.style.cssText = 'display:flex;align-items:center;gap:10px;padding:12px 16px;border-radius:12px;font-size:0.88rem;font-weight:500;border-left:4px solid ' + color + ';background:' + bg + ';color:' + color + ';box-shadow:0 4px 16px rgba(0,0,0,0.08);transform:translateX(-120%);opacity:0;transition:all 0.35s cubic-bezier(0.22,1,0.36,1);';
            toast.innerHTML = '<i class="bi bi-' + icon + '" style="font-size:1.1rem;flex-shrink:0;"></i><span style="flex:1;">' + message + '</span><button onclick="this.parentElement.remove()" style="background:none;border:none;color:' + color + ';font-size:1.2rem;cursor:pointer;padding:0;line-height:1;opacity:0.6;flex-shrink:0;">&times;</button>';
            existing.appendChild(toast);
            requestAnimationFrame(function () { toast.style.transform = 'translateX(0)'; toast.style.opacity = '1'; });
            setTimeout(function () {
                toast.style.transform = 'translateX(-120%)';
                toast.style.opacity = '0';
                setTimeout(function () { toast.remove(); }, 350);
            }, 4500);
        }
    </script>
}
