@using BoostingHub.backend.DTOs
@inject IJSRuntime JS

<div class="task-card @(Task.UserStatus == "Accepted" ? "task-card-accepted" : Task.UserStatus == "Completed" ? "task-card-completed" : "") @(IsSelected ? "task-card-selected" : "") @(IsExpired ? "task-card-expired" : "")" @onclick="OnCardClick" role="button" tabindex="@(IsExpired ? -1 : 0)">
    <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
        <span class="task-platform-badge"><i class="bi bi-globe2 me-1"></i>@Task.Platform</span>
        <span class="text-warning fw-bold fs-5">@_convertedSymbol@(_convertedAmount.ToString("F2"))</span>
    </div>
    <div class="d-flex align-items-center gap-2 mb-2">
        <span class="task-meta-item"><i class="bi bi-tag me-1"></i>@Task.Service</span>
        @if (IsExpired)
        {
            <span class="task-status-badge-expired" style="font-size:0.75rem;background:rgba(239,68,68,0.15);color:#EF4444;padding:2px 8px;border-radius:12px;"><i class="bi bi-clock-history me-1"></i>Expired</span>
        }
        else if (Task.UserStatus == "Accepted")
        {
            <span class="task-status-badge-accepted" style="font-size:0.75rem;background:rgba(59,130,246,0.15);color:#3B82F6;padding:2px 8px;border-radius:12px;"><i class="bi bi-check-circle me-1"></i>Accepted</span>
        }
        else if (Task.UserStatus == "Completed")
        {
            <span class="task-status-badge-completed" style="font-size:0.75rem;background:rgba(16,185,129,0.15);color:#10B981;padding:2px 8px;border-radius:12px;"><i class="bi bi-check2-all me-1"></i>Completed</span>
        }
    </div>
    @if (!string.IsNullOrEmpty(Task.Url))
    {
        <div class="task-meta-item mb-2"><i class="bi bi-link-45deg me-1"></i><span class="text-truncate d-inline-block" style="max-width:200px;">@Task.Url</span></div>
    }
    <div class="task-meta">
        <span class="task-meta-item"><i class="bi bi-people me-1"></i>@(Task.TargetQuantity - Task.CompletedQuantity) slots left</span>
    </div>
    <div class="task-footer">
        <span></span>
        <span class="text-muted small">#@Task.Id</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public AvailableTaskDto Task { get; set; } = new();
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }

    private bool IsExpired => string.Equals(Task.Status, "Expired", StringComparison.OrdinalIgnoreCase);

    private async Task OnCardClick()
    {
        if (IsExpired) return;
        await OnSelect.InvokeAsync();
    }

    private string _convertedSymbol = "";
    private decimal _convertedAmount;

    private string GetSymbol(string currency)
    {
        return currency switch
        {
            "PKR" => "\u20A8", "INR" => "\u20B9", "BDT" => "\u09F3", "GBP" => "\u00A3",
            "EUR" => "\u20AC", "USD" => "$", "CAD" => "C$", "AUD" => "A$",
            "SAR" => "\uFDFC", "AED" => "AED ", "TRY" => "\u20BA", "BRL" => "R$",
            "JPY" => "\u00A5", "CNY" => "\u00A5", "KRW" => "\u20A9", "NGN" => "\u20A6",
            "PHP" => "\u20B1", "IDR" => "Rp", "MYR" => "RM", "THB" => "\u0E3F",
            "EGP" => "E\u00A3", "ZAR" => "R", "MXN" => "Mex$",
            _ => currency + " "
        };
    }

    protected override async Task OnInitializedAsync()
    {
        var orderCurrency = Task.Currency ?? "USD";
        var userCurrency = orderCurrency;
        try
        {
            var cur = await JS.InvokeAsync<string>("__getUserCurrency");
            if (!string.IsNullOrEmpty(cur))
                userCurrency = cur;
        }
        catch { }

        _convertedSymbol = GetSymbol(userCurrency);

        if (string.Equals(orderCurrency, userCurrency, StringComparison.OrdinalIgnoreCase))
        {
            _convertedAmount = Task.RewardAmount;
        }
        else
        {
            try
            {
                _convertedAmount = await JS.InvokeAsync<decimal>("convertCurrency", Task.RewardAmount, orderCurrency, userCurrency);
            }
            catch
            {
                _convertedAmount = Task.RewardAmount;
            }
        }
    }
}
