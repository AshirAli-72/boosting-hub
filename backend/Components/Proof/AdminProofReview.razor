@using BoostingHub.backend.DTOs
@inject ITaskService TaskService
@inject ILogger<AdminProofReview> Logger
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="proof-review">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"><span class="visually-hidden">Loading...</span></div>
            <p class="mt-2 text-muted">Loading proofs...</p>
        </div>
    }
    else if (hasError)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        </div>
    }
    else
    {
        <div class="filter-bar d-flex flex-wrap gap-2 mb-4">
            <input type="text" class="form-control" style="flex:2;min-width:160px;" placeholder="Search by worker or service..." @bind="filter.Search" @bind:event="oninput" />
            <select class="form-select" style="flex:1;min-width:120px;" @bind="filter.Platform">
                <option value="">All Platforms</option>
                @foreach (var p in platforms)
                {
                    <option value="@p">@p</option>
                }
            </select>
            <button class="btn btn-primary" @onclick="LoadProofs"><i class="bi bi-search me-1"></i>Search</button>
        </div>

        @if (proofs.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">No proofs found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-table mb-0 align-middle">
                    <thead class="admin-thead">
                        <tr>
                            <th>ID</th>
                            <th>Worker</th>
                            <th>Platform</th>
                            <th>Service</th>
                            <th>Reward</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in proofs)
                        {
                            <tr>
                                <td class="fw-semibold">#@p.ProofId</td>
                                <td>@p.UserName</td>
                                <td><span class="admin-badge me-1" style="background:rgba(124,58,237,0.15);color:var(--primary-light);">@p.Platform</span></td>
                                <td><span class="admin-badge me-1" style="background:rgba(13,148,136,0.15);color:#0D9488;">@p.Service</span></td>
                                <td><span class="fw-bold" style="color:var(--success);">@GetCurrencySymbol(p.Currency ?? "USD")@p.Reward.ToString("F2")</span></td>
                                <td>
                                    @if (p.VerificationStatus == "PendingReview")
                                    {
                                        <span class="inquiry-status-badge inquiry-status-pending">Pending</span>
                                    }
                                    else if (p.VerificationStatus == "Approved")
                                    {
                                        <span class="inquiry-status-badge inquiry-status-approved">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="inquiry-status-badge inquiry-status-rejected">Rejected</span>
                                    }
                                </td>
                                <td><span class="admin-td-small">@p.SubmittedAt.ToString("MMM dd, yyyy")</span></td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-2 justify-content-end align-items-center flex-wrap">
                                        @if (p.VerificationStatus == "PendingReview")
                                        {
                                            <button class="btn btn-sm" @onclick="() => Approve(p.ProofId)"
                                                    style="border-radius:8px;font-weight:600;padding:4px 12px;background:rgba(16,185,129,0.15);color:#10B981;border:1px solid rgba(16,185,129,0.3);">
                                                <i class="bi bi-check-circle"></i> Approve
                                            </button>
                                            <button class="btn btn-sm" @onclick="() => OpenReject(p.ProofId)"
                                                    style="border-radius:8px;font-weight:600;padding:4px 12px;background:rgba(239,68,68,0.15);color:#EF4444;border:1px solid rgba(239,68,68,0.3);">
                                                <i class="bi bi-x-circle"></i> Reject
                                            </button>
                                        }
                                        @if (!string.IsNullOrEmpty(p.ImagePath))
                                        {
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenImageViewer(p.ImagePath)"
                                                    style="border-radius:8px;font-weight:500;padding:4px 10px;">
                                                <i class="bi bi-eye"></i> View
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <nav class="mt-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span class="text-muted small">Showing @(((currentPage - 1) * filter.PageSize) + 1)-@(Math.Min(currentPage * filter.PageSize, totalCount)) of @totalCount proofs</span>
                        <ul class="pagination mb-0">
                            <li class="page-item @(!hasPrevious ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(currentPage - 1)"><i class="bi bi-chevron-left"></i></button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(pageNum == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(pageNum)">@pageNum</button>
                                </li>
                            }
                            <li class="page-item @(!hasNext ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(currentPage + 1)"><i class="bi bi-chevron-right"></i></button>
                            </li>
                        </ul>
                    </div>
                </nav>
            }
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public int AdminUserId { get; set; }

    private DotNetObjectReference<AdminProofReview>? _dotNetRef;
    private List<ProofReviewDto> proofs = new();
    private bool isLoading = true;
    private bool hasError;
    private string? errorMessage;

    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount;
    private bool hasPrevious;
    private bool hasNext;
    private ProofReviewFilterDto filter = new();
    private List<string> platforms = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPlatforms();
        await LoadProofs();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    private async Task LoadPlatforms()
    {
        try { platforms = await TaskService.GetPlatformsAsync(); } catch { }
    }

    private async Task LoadProofs()
    {
        isLoading = true;
        hasError = false;
        errorMessage = null;
        try
        {
            filter.Page = currentPage;
            var result = await TaskService.GetProofsPendingReviewPagedAsync(filter);
            proofs = result.Items.ToList();
            totalCount = result.TotalCount;
            currentPage = result.Page;
            totalPages = result.TotalPages;
            hasPrevious = result.HasPrevious;
            hasNext = result.HasNext;
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
            Logger.LogError(ex, "Failed to load pending proofs");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadProofs();
    }

    private async Task Approve(int proofId)
    {
        try
        {
            var result = await TaskService.ApproveProofAsync(proofId);
            if (result.IsSuccess)
            {
                await JS.InvokeVoidAsync("showToast", result.Message, "success");
                var proof = proofs.FirstOrDefault(p => p.ProofId == proofId);
                if (proof != null)
                {
                    proof.VerificationStatus = "Approved";
                    proofs = new List<ProofReviewDto>(proofs);
                }
            }
            else
            {
                await JS.InvokeVoidAsync("showToast", result.Message, "danger");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to approve proof {ProofId}", proofId);
            await JS.InvokeVoidAsync("showToast", "Failed to approve proof.", "danger");
        }
    }

    private async Task OpenImageViewer(string? imagePath)
    {
        await JS.InvokeVoidAsync("open", imagePath, "_blank");
    }

    private async Task OpenReject(int proofId)
    {
        if (_dotNetRef is null) return;
        await JS.InvokeVoidAsync("showRejectModal", _dotNetRef, proofId);
    }

    [JSInvokable]
    public async Task OnRejectConfirm(int proofId, string reason)
    {
        try
        {
            var result = await TaskService.RejectProofAsync(proofId, reason);
            if (result.IsSuccess)
            {
                var proof = proofs.FirstOrDefault(p => p.ProofId == proofId);
                if (proof != null)
                {
                    proof.VerificationStatus = "Rejected";
                    proofs = new List<ProofReviewDto>(proofs);
                }
                await JS.InvokeVoidAsync("showToast", "Proof rejected successfully.", "success");
                await JS.InvokeVoidAsync("closeRejectModal");
            }
            else
            {
                await JS.InvokeVoidAsync("showRejectModalError", result.Message ?? "Failed to reject.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showRejectModalError", ex.Message);
            Logger.LogError(ex, "Failed to reject proof {ProofId}", proofId);
        }
    }

    [JSInvokable]
    public async Task OnRejectCancel()
    {
        await JS.InvokeVoidAsync("closeRejectModal");
    }

    private string GetCurrencySymbol(string? currency) => currency?.ToUpper() switch
    {
        "PKR" => "Rs.",
        "EUR" => "€",
        "GBP" => "£",
        "INR" => "₹",
        "BDT" => "৳",
        _ => "$"
    };

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
    }
}
