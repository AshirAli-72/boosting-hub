@inject IReportService ReportService

<div class="report-hub-card">

    @if (isLoading)
    {
        <div class="text-center py-4">
            <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
        </div>
    }
    else
    {
        <div class="report-metrics-grid">
            <div class="report-metric">
                <span class="report-metric-label">Total Proofs</span>
                <span class="report-metric-value" style="color:#F59E0B;">@TotalProofs</span>
            </div>
            <div class="report-metric">
                <span class="report-metric-label">Paid</span>
                <span class="report-metric-value" style="color:#10B981;">@PaidProofs</span>
            </div>
            <div class="report-metric">
                <span class="report-metric-label">Pending</span>
                <span class="report-metric-value" style="color:#F59E0B;">@PendingProofs</span>
            </div>
            <div class="report-metric">
                <span class="report-metric-label">Rejected</span>
                <span class="report-metric-value" style="color:#EF4444;">@RejectedProofs</span>
            </div>
            <div class="report-metric">
                <span class="report-metric-label">Total Paid</span>
                <span class="report-metric-value" style="color:#10B981;">₨@TotalPaidAmount.ToString("N0")</span>
            </div>
            <div class="report-metric">
                <span class="report-metric-label">Avg. Paid</span>
                <span class="report-metric-value">₨@AvgPaidAmount.ToString("N0")</span>
            </div>
        </div>

        @if (DailySubmissions.Any())
        {
            <div class="mt-3">
                <div class="report-chart-label">Submissions (Last 7 Days)</div>
                <div class="report-bar-chart">
                    @{ var maxVal = DailySubmissions.Values.Any() ? DailySubmissions.Values.Max() : 1; }
                    @foreach (var kvp in DailySubmissions)
                    {
                        var pct = maxVal > 0 ? (double)kvp.Value / (double)maxVal * 100 : 0;
                        <div class="report-bar-item">
                            <div class="report-bar-label">@kvp.Key</div>
                            <div class="report-bar-track">
                                <div class="report-bar-fill" style="width:@pct.ToString("F0")%;background:linear-gradient(90deg,#F59E0B,#D97706);"></div>
                            </div>
                            <div class="report-bar-val">@kvp.Value</div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private bool isLoading = true;
    private int TotalProofs;
    private int PendingProofs;
    private int PaidProofs;
    private int RejectedProofs;
    private decimal TotalPaidAmount;
    private decimal AvgPaidAmount;
    private Dictionary<string, int> DailySubmissions = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var data = await ReportService.GetManualPaymentProofsReportAsync();
            TotalProofs      = data.TotalProofs;
            PendingProofs    = data.PendingProofs;
            PaidProofs       = data.PaidProofs;
            RejectedProofs   = data.RejectedProofs;
            TotalPaidAmount  = data.TotalPaidAmount;
            AvgPaidAmount    = data.AvgPaidAmount;
            DailySubmissions = data.DailySubmissions;
        }
        catch { }
        finally { isLoading = false; }
    }
}
